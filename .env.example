# ==============================================================================
# THAARA V2 Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit .env or real credentials to source control.
# In production, use managed secret managers (e.g. AWS Secrets Manager, Vault).
# ==============================================================================

# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# API Server Configuration
PORT=3000
HOST=127.0.0.1

# Web App Client URL (used for CORS allow-list)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://thaara_app:your_secure_password_here@localhost:5432/thaara_v2
MIGRATION_DATABASE_URL=postgresql://thaara_admin:your_secure_password_here@localhost:5432/thaara_v2

# Redis Connection (Redis 7)
# Local docker connection string
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets
# In development, these must be set to custom random values (min 32 characters).
# The application will refuse to boot if default placeholders are detected in non-test environments.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_char_random_secret_in_env
CSRF_SECRET=replace_with_at_least_32_char_random_secret_in_env

# Cookie Configuration
# In production, COOKIE_SECURE must be true and COOKIE_DOMAIN set to your domain.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Observability
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
