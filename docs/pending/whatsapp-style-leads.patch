+import {tmpdir} from 'node:os';import {join,resolve,sep} from 'node:path';
+import {createWhatsAppLeadFileSecretResolver} from '../src/services/whatsapp-lead-secret-file';
+async function cleanup(dir:string){const parent=resolve(tmpdir())+sep,target=resolve(dir),child=target.slice(parent.length);if(!target.startsWith(parent)||!child.startsWith('wa-lead-')||child.includes(sep))throw Error('Unsafe temporary cleanup');await rm(target,{recursive:true,force:true});}
+describe('dedicated WhatsApp pilot protected secret file',()=>{
+ it('reads only a dedicated regular secret file and never exposes contents on failure',async()=>{
+  const dir=await mkdtemp(join(tmpdir(),'wa-lead-'));const path=join(dir,'thaara-whatsapp-leads-bridge');
+  try{const resolve=createWhatsAppLeadFileSecretResolver(path);await expect(resolve()).rejects.toThrow('unavailable');await writeFile(path,'s'.repeat(64)+'\n',{mode:0o600});expect(await resolve()).toBe('s'.repeat(64));await writeFile(path,'bad token');await expect(resolve()).rejects.toThrow('WhatsApp lead bridge secret is unavailable.');await writeFile(path,'x'.repeat(400));await expect(resolve()).rejects.toThrow('unavailable');}finally{await cleanup(dir);}
+ });
+ it('rejects relative paths and existing Phone credential paths',()=>{expect(()=>createWhatsAppLeadFileSecretResolver('relative')).toThrow('unavailable');expect(()=>createWhatsAppLeadFileSecretResolver('/run/secrets/phone-inbound-token')).toThrow('unavailable');});
+ it.skipIf(process.platform==='win32')('rejects a group-readable secret or symlink on the Linux pilot',async()=>{
+  const dir=await mkdtemp(join(tmpdir(),'wa-lead-'));const path=join(dir,'thaara-whatsapp-leads-bridge');try{await writeFile(path,'s'.repeat(64),{mode:0o640});await expect(createWhatsAppLeadFileSecretResolver(path)()).rejects.toThrow('unavailable');await chmod(path,0o600);const original=join(dir,'original');await writeFile(original,'x'.repeat(64),{mode:0o600});await rm(path);await symlink(original,path);await expect(createWhatsAppLeadFileSecretResolver(path)()).rejects.toThrow('unavailable');}finally{await cleanup(dir);}
+ });
+});
