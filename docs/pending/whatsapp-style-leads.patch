+import {describe,it,expect} from 'vitest';
+import {spawnSync} from 'node:child_process';
+import {resolve} from 'node:path';
+import {pathToFileURL} from 'node:url';
+const moduleUrl=pathToFileURL(resolve('apps/api/dist/services/whatsapp-lead-delegation.js')).href;
+function check(query:string){
+ const script=`import {createWhatsAppLeadPool} from ${JSON.stringify(moduleUrl)}; const url='postgresql://thaara_whatsapp_leads_user:'+('synthetic_'.repeat(8))+'@db-callback.quantumweaveai.io:443/thaara_test?'+${JSON.stringify(query)}; try { const pool=createWhatsAppLeadPool(url); const o=pool.options; console.log(JSON.stringify({accepted:true,negotiation:o.sslnegotiation,verify:o.ssl.rejectUnauthorized,serverName:o.ssl.servername,urlOptionsStripped:!o.connectionString.includes('sslmode=')}));await pool.end(); } catch {console.log(JSON.stringify({accepted:false}));}`;
+ const result=spawnSync(process.execPath,['--input-type=module','-e',script],{encoding:'utf8',timeout:15000});
+ expect(result.status,'native module/configuration check failed').toBe(0);return JSON.parse(result.stdout.trim());
+}
+describe('WhatsApp native database TLS compatibility',()=>{
+ it('uses PostgreSQL STARTTLS with certificate/hostname verification',()=>{expect(check('sslmode=verify-full&sslnegotiation=postgres')).toEqual({accepted:true,negotiation:'postgres',verify:true,serverName:'db-callback.quantumweaveai.io',urlOptionsStripped:true});});
+ it('rejects direct negotiation incompatible with this gateway',()=>{expect(check('sslnegotiation=direct')).toEqual({accepted:false});});
+ it('refuses downgrade and unrelated certificate files',()=>{for(const q of ['sslmode=disable','sslmode=require','sslrootcert=/run/secrets/phone-cert','sslnegotiation=unknown'])expect(check(q)).toEqual({accepted:false});});
+});
