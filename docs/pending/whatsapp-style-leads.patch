+import {DistributedJobQueue} from './queue.js';
+import {pathToFileURL} from 'node:url';
+/** Feature-only entrypoint. No generic sweepers, browser sessions or unrelated queue consumers. */
+export async function createWhatsAppLeadsPilotService(env:Record<string,string|undefined>=process.env){
+ if(env.THAARA_WHATSAPP_LEADS_ENABLED!=='true')return{status:'not_configured',start:async()=>{},stop:async()=>{}};
+ try{
+  const grantId=env.THAARA_WHATSAPP_LEADS_APPROVAL_ID??'';if(!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(grantId))throw Error();
+  const moduleUrl=new URL('../../api/dist/services/whatsapp-lead-delegation.js',import.meta.url);
+  const secretsUrl=new URL('../../api/dist/services/whatsapp-lead-secret-file.js',import.meta.url);
+  const {createWhatsAppLeadPool,WhatsAppLeadDelegation,createDelegatedWhatsAppLeadHandler,WHATSAPP_LEAD_PROFILE}=await import(moduleUrl.href);
+  const secrets=await import(secretsUrl.href);
+  const databaseUrl=await secrets.createWhatsAppLeadDatabaseUrlResolver()();
+  const redisUrl=await secrets.createWhatsAppLeadRedisUrlResolver()();
+  const redis=new URL(redisUrl);if(!['redis:','rediss:'].includes(redis.protocol)||!['redis','thaara-v2-pilot-redis-1'].includes(redis.hostname)||redis.search||redis.hash)throw Error();
+  const pool=createWhatsAppLeadPool(databaseUrl);
+  const delegation=new WhatsAppLeadDelegation(pool,grantId);
+  const handler=createDelegatedWhatsAppLeadHandler({enabled:true,delegation,resolveBridgeSecret:secrets.createWhatsAppLeadFileSecretResolver()});
+  const queue=new DistributedJobQueue(redisUrl,null,undefined,undefined,handler,true);
+  let status='configured_disabled';return{get status(){return status;},start:async()=>{await queue.scheduleWhatsAppLeads({workspaceId:WHATSAPP_LEAD_PROFILE.workspaceId,connectionId:WHATSAPP_LEAD_PROFILE.connectionId});queue.startWorker();await queue.waitForLeadWorkerReady();status='running_unverified';},stop:async()=>{await queue.close();await pool.end();}};
+ }catch{throw new Error('WhatsApp lead worker configuration is unavailable.');}
+}
+if(process.argv[1]&&import.meta.url===pathToFileURL(process.argv[1]).href){
+ createWhatsAppLeadsPilotService().then(async service=>{await service.start();console.log(JSON.stringify({status:service.status}));for(const signal of ['SIGINT','SIGTERM'] as const)process.once(signal,()=>{service.stop().then(()=>process.exit(0)).catch(()=>process.exit(1));});}).catch(()=>{console.error('WhatsApp lead worker configuration is unavailable.');process.exitCode=1;});
+}
