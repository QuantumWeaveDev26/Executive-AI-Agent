+    return {
+      allowed: false,
+      reason: 'opted_out',
+      escalationReason: 'opt_out',
+      language,
+      replyText: null,
+      statusNote: 'Customer requested to stop receiving messages. Automated replies are blocked.',
+      knowledgeVersion: QUANTUM_WEAVE_WHATSAPP_KB_VERSION
