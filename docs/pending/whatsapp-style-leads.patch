+}
+
+function getActiveSessionMessages(messages: ExtractEnquiryInput['messages']): ExtractEnquiryInput['messages'] {
+  const sorted = [...messages]
+    .filter(m => m.textPreview.trim().length > 0)
+    .sort((a, b) => a.timestamp.localeCompare(b.timestamp) || (a.direction === b.direction ? 0 : a.direction === 'inbound' ? -1 : 1));
+  if (sorted.length <= 1) return sorted;
+
+  let startIndex = 0;
+  for (let i = 1; i < sorted.length; i++) {
+    const prev = sorted[i - 1]!;
+    const curr = sorted[i]!;
+    const prevMs = Date.parse(prev.timestamp);
+    const currMs = Date.parse(curr.timestamp);
+    if (Number.isFinite(prevMs) && Number.isFinite(currMs) && currMs - prevMs > SESSION_RESET_GAP_MS) {
+      startIndex = i;
+      continue;
+    }
+    if (
+      curr.direction === 'inbound' &&
+      FRESH_SESSION_INTRO_PATTERN.test(curr.textPreview.trim()) &&
+      sorted.slice(startIndex, i).some(m => m.direction === 'inbound')
+    ) {
+      startIndex = i;
+    }
+  }
+  return sorted.slice(startIndex);
+}
+
+function selectPrimaryService(inboundTexts: string[]): { service?: string; turnIndex: number } {
+  let primaryService: string | undefined;
+  let primaryIndex = -1;
+
+  for (let i = 0; i < inboundTexts.length; i++) {
+    const text = inboundTexts[i]!;
+    const numMatched = matchNumberedService(text);
+    if (numMatched) {
+      primaryService = numMatched.name;
+      primaryIndex = i;
+      continue;
+    }
+    const matched = SERVICE_MATCHERS.find(m => m.pattern.test(text))?.label;
+    if (!matched) continue;
+    if (!primaryService) {
+      primaryService = matched;
+      primaryIndex = i;
+      continue;
+    }
+    // Preserve 'WhatsApp Automation' when subsequent turns describe requirements like "customer support and lead generation"
+    // unless the customer explicitly asks to switch or inquire about a different service.
+    const explicitServiceSwitch =
+      /\b(?:also|instead|switch\s+to|what\s+about|tell\s+me\s+about|interested\s+in|build\s+a|build\s+ai|100[\s-]*day|website|mobile\s+app|training|visual\s+storytelling|creative\s+content|executive\s+ai|ai\s+agent|ai\s+employee|workforce|i\s+need|we\s+need|need\s+whatsapp|looking\s+to)\b/i.test(
+        text
+      ) && !USE_CASE_REQUIREMENT_PATTERN.test(text);
+    if (explicitServiceSwitch || (!USE_CASE_REQUIREMENT_PATTERN.test(text) && matched !== primaryService)) {
+      primaryService = matched;
+      primaryIndex = i;
+    }
+  }
+  return { service: primaryService, turnIndex: primaryIndex };
+}
