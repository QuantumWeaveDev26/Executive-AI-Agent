+-- Does not alter source messages, connections, approvals, jobs, Phone or other tables.
+BEGIN;
+CREATE TABLE public.whatsapp_lead_register_v1 (
+ workspace_id uuid NOT NULL, owner_user_id uuid NOT NULL, connection_id text NOT NULL,
+ lead_id text NOT NULL CHECK (lead_id ~ '^[a-f0-9]{64}$'),
+ sheet_row bigint GENERATED BY DEFAULT AS IDENTITY (START WITH 2) UNIQUE,
+ payload jsonb NOT NULL CHECK (jsonb_typeof(payload)='object' AND octet_length(payload::text)<=16000),
+ version bigint NOT NULL DEFAULT 1 CHECK(version>0),
+ sync_status text NOT NULL DEFAULT 'queued' CHECK(sync_status IN ('queued','inflight','synced','unverified','awaiting_approval','failed')),
+ claim_token uuid, attempts integer NOT NULL DEFAULT 0 CHECK(attempts>=0),
+ next_attempt_at timestamptz NOT NULL DEFAULT now(), last_error_code text,
+ PRIMARY KEY(workspace_id,owner_user_id,connection_id,lead_id)
+);
+CREATE INDEX whatsapp_lead_register_v1_pending ON public.whatsapp_lead_register_v1(workspace_id,owner_user_id,connection_id,next_attempt_at) WHERE sync_status IN ('queued','awaiting_approval');
