+import {describe,it,expect} from 'vitest';
+import {WhatsAppAIService,buildWhatsAppSystemPrompt} from '../src/services/whatsapp-ai-service.js';
+import type {ModelGatewayAdapter,ModelPromptContext} from '../src/services/model-gateway.js';
+const campaign={campaignId:'synthetic-campaign',title:'Synthetic approved workshop',relevantFacts:'Verified synthetic campaign fee: INR 2500.',groundedAnswer:'The verified campaign fee is INR 2500.',grounded:true,pricingExplicitlyProvided:true,sourceRefs:['synthetic-fixture']};
+const input={connectionId:'synthetic-connection',recipientId:'synthetic-recipient',phoneE164:'+919000000001',latestCustomerMessage:'What is the workshop fee?',conversationHistory:[{role:'user' as const,content:'I run a synthetic retail business.'}],campaignContext:campaign};
+describe('WhatsApp mobile presentation preserves concurrent campaign behavior',()=>{
+ it('retains factual campaign context and verified-pricing policy in the WhatsApp prompt',()=>{const prompt=buildWhatsAppSystemPrompt({campaignContext:campaign});expect(prompt).toContain(campaign.relevantFacts);expect(prompt).toContain('<campaign_reference_data>');expect(prompt).toContain('You MAY state ONLY the exact verified pricing');});
+ it('preserves the existing grounded campaign fallback when the model is unavailable',async()=>{const result=await new WhatsAppAIService().generateCustomerReply(input);expect(result.status).toBe('generated');expect(result.source).toBe('fallback_template');expect(result.replyText).toBe(campaign.groundedAnswer);});
+ it('preserves verified campaign prices and conversation context while formatting the reply',async()=>{let captured:ModelPromptContext|undefined;const gateway:ModelGatewayAdapter={async *streamResponse(context){captured=context;yield{type:'token',delta:'The verified campaign fee is \u20b92500.'};}};const result=await new WhatsAppAIService(gateway).generateCustomerReply(input);expect(result.replyText).toContain('2500');expect(captured?.conversationHistory).toEqual(input.conversationHistory);expect(captured?.userMessage).toBe(input.latestCustomerMessage);expect(captured?.systemPrompt).toContain(campaign.relevantFacts);});
+ it('keeps the existing restriction on numeric custom prices without verified campaign pricing',async()=>{const gateway:ModelGatewayAdapter={async *streamResponse(){yield{type:'token',delta:'The fee is \u20b92500.'};}};const result=await new WhatsAppAIService(gateway).generateCustomerReply({...input,campaignContext:{...campaign,pricingExplicitlyProvided:false}});expect(result.replyText??'').not.toContain('2500');});
+});
diff --git a/apps/api/src/services/whatsapp-lead-delegation.ts b/apps/api/src/services/whatsapp-lead-delegation.ts
new file mode 100644
index 0000000..4091ad2
--- /dev/null
+++ b/apps/api/src/services/whatsapp-lead-delegation.ts
@@ -0,0 +1,75 @@
+import {createRequire} from 'node:module';
+import {randomUUID} from 'node:crypto';
+import type {DbClient} from '@thaara/db';
+import type {ApprovalRequest} from '@thaara/contracts';
+import type {LeadDatabase} from './whatsapp-lead-postgres.js';
+import type {LeadExecutionScope,DelegatedLeadScope} from './whatsapp-lead-scope.js';
+import {LEAD_SYNC_ACTION,type LeadWriteParameters} from './whatsapp-lead-sync.js';
+import {WHATSAPP_LEAD_TARGET,createWhatsAppLeadQueueHandler} from './whatsapp-lead-runtime.js';
+export const WHATSAPP_LEAD_PROFILE={workspaceId:'75d2f889-d3eb-4acc-861a-fada4691ecce',userId:'4b4cbc9c-df01-4cc2-8565-8a23a3435b9d',connectionId:'wa_pilot_meta_test_10813b',...WHATSAPP_LEAD_TARGET} as const;
+const unavailable=()=>new Error('WhatsApp lead authorization is unavailable.');
+export interface LeadPoolClient{query(sql:string,params?:unknown[]):Promise<{rows:any[]}>;release():void}
+export interface LeadPool{connect():Promise<LeadPoolClient>;end():Promise<void>;on?(event:string,listener:()=>void):unknown}
+interface Grant{workspace_id:string;user_id:string;role:string;grant_id:string;expires_at:string|Date;approved_at:string|Date}
+const uuid=(v:string)=>/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(v);
+/** Dedicated DB identity plus a purpose-bound owner approval. Never constructs a browser session or borrows Phone credentials. */
+export class WhatsAppLeadDelegation implements LeadDatabase{
+ constructor(private pool:LeadPool,private approvalId:string){if(!uuid(approvalId))throw unavailable();}
+ private valid(row:Grant|undefined):row is Grant{return Boolean(row&&row.workspace_id===WHATSAPP_LEAD_PROFILE.workspaceId&&row.user_id===WHATSAPP_LEAD_PROFILE.userId&&row.role==='owner'&&row.grant_id===this.approvalId&&new Date(row.expires_at).getTime()>Date.now());}
+ private async transaction<T>(scope:LeadExecutionScope|null,operation:(tx:DbClient,grant:Grant|null)=>Promise<T>):Promise<T>{
+  let client:LeadPoolClient|undefined;
+  try{
+   client=await this.pool.connect();await client.query('BEGIN');await client.query('SET LOCAL ROLE thaara_whatsapp_leads');
+   const identity=(await client.query('SELECT session_user,current_user')).rows[0];
+   if(identity?.session_user!=='thaara_whatsapp_leads_user'||identity?.current_user!=='thaara_whatsapp_leads')throw unavailable();
+   await client.query("SET LOCAL statement_timeout='15s'");
+   await client.query("SELECT pg_catalog.set_config('app.whatsapp_lead_approval_id',$1,true)",[this.approvalId]);
+   const grant=(await client.query('SELECT * FROM public.whatsapp_lead_resolve_grant_v1($1)',[this.approvalId])).rows[0] as Grant|undefined;
+   const active=this.valid(grant)?grant:null;
+   if(scope&&(!active||!('kind' in scope)||scope.kind!=='whatsapp_leads_service'||scope.delegationId!==this.approvalId||scope.workspaceId!==active.workspace_id||scope.userId!==active.user_id||scope.role!=='owner'))throw unavailable();
+   if(active){await client.query("SELECT pg_catalog.set_config('app.workspace_id',$1,true),pg_catalog.set_config('app.user_id',$2,true),pg_catalog.set_config('app.role','owner',true)",[active.workspace_id,active.user_id]);}
+   const owned=client;const tx:DbClient={query:async<R=any>(sql:string,params?:any[])=>{const result=await owned.query(sql,params);return{rows:result.rows as R[]};},exec:async(sql:string)=>{await owned.query(sql);}};
+   const result=await operation(tx,active);await client.query('COMMIT');return result;
+  }catch{if(client){try{await client.query('ROLLBACK');}catch{}}throw unavailable();}finally{client?.release();}
+ }
+ withScopedTransaction<T>(scope:LeadExecutionScope,operation:(tx:DbClient)=>Promise<T>){return this.transaction(scope,tx=>operation(tx));}
+ async resolveApprovedBinding(){return this.transaction(null,async(_tx,grant)=>{
+  if(!grant)return null;
+  const scope:DelegatedLeadScope={workspaceId:grant.workspace_id,userId:grant.user_id,role:'owner',kind:'whatsapp_leads_service',delegationId:grant.grant_id};
+  return{scope,connectionId:WHATSAPP_LEAD_PROFILE.connectionId,target:{...WHATSAPP_LEAD_TARGET},approvalExpiresAt:new Date(grant.expires_at).getTime()};
+ });}
+ approvalFor=async(tx:DbClient,scope:LeadExecutionScope,params:LeadWriteParameters):Promise<ApprovalRequest|null>=>{
+  const grant=(await tx.query<Grant>('SELECT * FROM public.whatsapp_lead_resolve_grant_v1($1)',[this.approvalId])).rows[0];
+  if(!this.valid(grant)||!('kind' in scope)||scope.delegationId!==this.approvalId||scope.workspaceId!==grant.workspace_id||scope.userId!==grant.user_id||params.connectionId!==WHATSAPP_LEAD_PROFILE.connectionId||params.spreadsheetId!==WHATSAPP_LEAD_TARGET.spreadsheetId||params.sheetName!==WHATSAPP_LEAD_TARGET.sheetName)return null;
+  const values=[grant.workspace_id,grant.user_id,params.connectionId,params.leadId,params.version,this.approvalId];
+  await tx.query(`INSERT INTO public.whatsapp_lead_write_authorizations_v1(id,workspace_id,owner_user_id,connection_id,lead_id,version,grant_id,action_params,expires_at) VALUES($7,$1,$2,$3,$4,$5,$6,$8::jsonb,$9) ON CONFLICT(workspace_id,owner_user_id,connection_id,lead_id,version,grant_id) DO NOTHING`,[...values,randomUUID(),JSON.stringify(params),new Date(grant.expires_at).toISOString()]);
+  const row=(await tx.query<{id:string;action_params:LeadWriteParameters;expires_at:string|Date;created_at:string|Date}>(`SELECT id,action_params,expires_at,created_at FROM public.whatsapp_lead_write_authorizations_v1 WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 AND lead_id=$4 AND version=$5 AND grant_id=$6`,values)).rows[0];
+  if(!row||new Date(row.expires_at).getTime()<=Date.now()||Object.keys(params).some(k=>JSON.stringify(params[k as keyof LeadWriteParameters])!==JSON.stringify(row.action_params[k as keyof LeadWriteParameters]))||Object.keys(row.action_params).length!==Object.keys(params).length)return null;
+  return{id:row.id,workspaceId:grant.workspace_id,requesterUserId:grant.user_id,approverUserId:grant.user_id,actionName:LEAD_SYNC_ACTION,actionParams:{...params},riskLevel:'high',status:'approved',createdAt:new Date(row.created_at).toISOString(),updatedAt:new Date(row.created_at).toISOString(),expiresAt:new Date(row.expires_at).toISOString()};
+ };
+}
+export function createDelegatedWhatsAppLeadHandler(options:{enabled:boolean;delegation:WhatsAppLeadDelegation;resolveBridgeSecret:()=>Promise<string>;fetch?:typeof fetch}){
+ const run=createWhatsAppLeadQueueHandler({enabled:options.enabled,serviceViews:true,db:options.delegation,resolveApprovedBinding:()=>options.delegation.resolveApprovedBinding(),approvalFor:options.delegation.approvalFor,resolveBridgeSecret:options.resolveBridgeSecret,fetch:options.fetch});
+ return async(data:Parameters<typeof run>[0])=>{const result=await run(data);const status=result.result.status;
+  if(['idle','queued','inflight','unverified','failed','awaiting_approval','not_configured'].includes(status))console.log(JSON.stringify({component:'whatsapp_leads',status,projected:'projected' in result.result?result.result.projected:0,synced:'synced' in result.result?result.result.synced:0}));
+  return result;
+ };
+}
+
+/** Reuse the existing DB package's installed driver. Certificate verification is mandatory. */
+export function createWhatsAppLeadPool(databaseUrl:string):LeadPool{
+ try{
+  const url=new URL(databaseUrl);
+  if(!['postgres:','postgresql:'].includes(url.protocol)||url.hostname!=='db-callback.quantumweaveai.io'||url.username!=='thaara_whatsapp_leads_user'||decodeURIComponent(url.password).length<32||url.pathname.length<2)throw unavailable();
+  // Never let URL parameters turn off TLS or load an unrelated credential/certificate file.
+  if([...url.searchParams.keys()].some(k=>!['sslmode','sslnegotiation'].includes(k)))throw unavailable();
+  if(url.searchParams.has('sslmode')&&url.searchParams.get('sslmode')!=='verify-full')throw unavailable();
+  if(url.searchParams.has('sslnegotiation')&&url.searchParams.get('sslnegotiation')!=='postgres')throw unavailable();
+  url.search='';
+  const driver=createRequire(import.meta.resolve('@thaara/db'))('pg') as {Pool:new(config:Record<string,unknown>)=>LeadPool;Client:new(config:Record<string,unknown>)=>{sslNegotiation?:string;ssl?:{rejectUnauthorized?:boolean}}};
+  const config={connectionString:url.toString(),ssl:{rejectUnauthorized:true,servername:url.hostname},sslnegotiation:'postgres',max:2,idleTimeoutMillis:10000,connectionTimeoutMillis:10000,application_name:'thaara_whatsapp_leads_pilot'};
+  const probe=new driver.Client(config);if(probe.sslNegotiation!=='postgres'||probe.ssl?.rejectUnauthorized!==true)throw unavailable();
+  const pool=new driver.Pool(config);
+  pool.on?.('error',()=>{console.error('WhatsApp lead database connection is unavailable.');});return pool;
+ }catch{throw unavailable();}
+}
