+      /\b(?:i(?:'m| am| am a|'m a))\s+([A-Za-z0-9&/ -]{2,35}?(?:\s+(?:filmmaker|producer|director|creator|developer|designer|consultant|doctor|coach|founder|author|marketer)))\b/i.exec(text) ??
