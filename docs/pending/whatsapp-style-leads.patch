+import {describe,it,expect} from 'vitest';
+import {buildWhatsAppLead,leadCells,LEAD_HEADERS} from '../src/services/whatsapp-lead-register';
+const scope={workspaceId:'10000000-0000-4000-8000-000000000001',userId:'10000000-0000-4000-8000-000000000002'};
+const msg=(text:string,time='2026-11-17T08:00:00Z')=>({providerMessageId:text,recipientId:'c_919876543210',textPreview:text,timestamp:time});
+function build(messages:any[],previous?:any,extra={}){return buildWhatsAppLead({...scope,connectionId:'test-account',recipientId:'c_919876543210',phoneE164:'+919876543210',messages,outbound:[],previous,...extra});}
+describe('durable WhatsApp lead projection',()=>{
+ it('captures first contact without requiring name, opt-in, qualification or AI generation',()=>{
+  const lead=build([msg('Hi')]);expect(lead.phone).toBe('+919876543210');expect(lead.name).toBe('');expect(lead.status).toBe('New');expect(lead.appointment).toBe('Unknown');expect(leadCells(lead,1)).toHaveLength(LEAD_HEADERS.length);
+ });
+ it('progressively updates the same stable identity across restarts and duplicate/out-of-order source rows',()=>{
+  const first=build([msg('Hi')]);const next=build([msg("My name is Krishna. I run a real estate company and I am interested in AI calling agents.",'2026-11-17T09:00:00Z')],first);
+  expect(next.id).toBe(first.id);expect(next.firstContact).toBe(first.firstContact);expect(next.name).toBe('Krishna');expect(next.businessType.toLowerCase()).toContain('real estate');expect(next.service).not.toBe('');expect(next.status).toBe('Interested');
+  const old=build([msg('Hi','2026-11-16T08:00:00Z')],next);expect(old.name).toBe('Krishna');expect(old.lastContact).toBe(next.lastContact);expect(old.lastMessage).toBe(next.lastMessage);
+ });
+ it('keeps a stable sender distinct between workspaces and business accounts',()=>{
+  const a=build([msg('Hi')]);expect(build([msg('Hi')],undefined,{connectionId:'other-account'}).id).not.toBe(a.id);expect(build([msg('Hi')],undefined,{workspaceId:'other-workspace'}).id).not.toBe(a.id);
+ });
+ it('never marks a shared booking link or customer claim as a verified appointment',()=>{
+  const row=build([msg('I booked a meeting. Can I speak with your team?')],undefined,{outbound:[{text:'https://calendly.com/team-brandmint/30min',verifiedSent:true}]});expect(row.calendlyShared).toBe(true);expect(row.appointment).toBe('Requested');expect(row.status).toBe('Call Requested');
+  expect(build([msg('Hi')],undefined,{outbound:[{text:'https://calendly.com/team-brandmint/30min',verifiedSent:false}]}).calendlyShared).toBe(false);
+ });
+ it('preserves verified details through empty turns, handles optout and stages erasure without retaining PII',()=>{
+  const before=build([msg('My name is Krishna')]);expect(build([msg('Hi','2026-11-18T08:00:00Z')],before).name).toBe('Krishna');
+  expect(build([msg('STOP','2026-11-18T09:00:00Z')],before).status).toBe('Not Interested');const erased=build([msg('Delete my data','2026-11-18T10:00:00Z')],before);expect(erased.erased).toBe(true);expect(erased.phone).toBe('');expect(erased.name).toBe('');expect(build([msg('Hi')],erased).erased).toBe(true);
+ });
+ it('does not make spreadsheet formulas from customer input',()=>{
+  const row=build([msg('Hi')]);const cells=leadCells({...row,name:'=IMPORTXML("https://bad.invalid")',lastMessage:'+123'},1);expect(cells).toContain("'=IMPORTXML(\"https://bad.invalid\")");expect(cells).toContain("'+123");
+ });
+ it('honors a deletion received before a later greeting in the same capture batch',()=>{
+  const row=build([msg('My name is Krishna'),msg('Delete my data','2026-11-17T09:00:00Z'),msg('Hi','2026-11-17T10:00:00Z')]);expect(row.erased).toBe(true);expect(row.name).toBe('');expect(row.lastMessage).toBe('');
+ });
+});
