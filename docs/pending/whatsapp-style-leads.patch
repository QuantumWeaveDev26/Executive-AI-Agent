+      /^(?:i\s+run\s+a\s+|we\s+run\s+a\s+|it'?s\s+a\s+)?([A-Za-z0-9&/ -]{2,30}\s+(?:shop|store|clinic|hospital|restaurant|boutique|showroom|business|production))\b/i.exec(text.trim());
