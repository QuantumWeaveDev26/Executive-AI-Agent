+const guard=node({type:'n8n-nodes-base.code',version:2,config:{name:'Validate pinned lead-sheet request',parameters:{mode:'runOnceForAllItems',jsCode:"const approved = (function validateLeadSheetBridgeBody(body){\n const target='1Roo0IaLx5flncIiESj5QqiOtNWqpZgnAuSsnWAyo3QQ',sheet='WhatsApp Enquiries';\n if(!body||Array.isArray(body)||typeof body!=='object'||Object.keys(body).some(k=>!['operation','spreadsheetId','sheetName','row','cells','leadId','valueInputOption'].includes(k)))throw Error('Lead request denied');\n if(body.spreadsheetId!==target||body.sheetName!==sheet||!['read','write','locate'].includes(body.operation)||!Number.isSafeInteger(body.row)||body.row<1||body.row>1000)throw Error('Lead request denied');\n if(body.operation==='write'&&(body.row===1||body.valueInputOption!=='RAW'||!Array.isArray(body.cells)||body.cells.length!==16||body.cells.some(x=>typeof x!=='string'||x.length>2048)))throw Error('Lead write denied');\n if(body.operation==='locate'&&!/^[a-f0-9]{64}$/.test(body.leadId??''))throw Error('Lead lookup denied');\n const range=body.operation==='locate'?\"'WhatsApp Enquiries'!O2:O1000\":\"'WhatsApp Enquiries'!A\"+body.row+':P'+body.row;\n return {operation:body.operation,row:body.row,cells:body.operation==='write'?body.cells:[],leadId:body.operation==='locate'?body.leadId:'',googleUrl:'https://sheets.googleapis.com/v4/spreadsheets/'+target+'/values/'+encodeURIComponent(range)+(body.operation==='write'?'?valueInputOption=RAW':'')};\n})($input.first().json.body); return [{json: approved}];"}}});
+const branch=ifElse({version:2.2,config:{name:'Fixed-row write?',parameters:{conditions:{options:{caseSensitive:true,leftValue:'',typeValidation:'strict'},conditions:[{leftValue:expr('{{ $json.operation }}'),rightValue:'write',operator:{type:'string',operation:'equals'}}],combinator:'and'}}}});
+const creds={googleSheetsOAuth2Api:{id:'f6xp2TgRY2LfEEC0',name:'Google Sheets account'}};
+const opts={timeout:10000,redirect:{redirect:{followRedirects:false}},response:{response:{responseFormat:'json',neverError:false}}};
+const read=node({type:'n8n-nodes-base.httpRequest',version:4.3,config:{name:'Read fixed sheet range',parameters:{method:'GET',url:expr('{{ $json.googleUrl }}'),authentication:'predefinedCredentialType',nodeCredentialType:'googleSheetsOAuth2Api',options:opts},credentials:creds}});
+const write=node({type:'n8n-nodes-base.httpRequest',version:4.3,config:{name:'Write approved row RAW',parameters:{method:'PUT',url:expr('{{ $json.googleUrl }}'),authentication:'predefinedCredentialType',nodeCredentialType:'googleSheetsOAuth2Api',sendBody:true,specifyBody:'json',jsonBody:expr('{{ {majorDimension:"ROWS",values:[$json.cells]} }}'),options:opts},credentials:creds}});
+const format=node({type:'n8n-nodes-base.code',version:2,config:{name:'Return bounded sheet result',parameters:{mode:'runOnceForAllItems',jsCode:"const request = $(\"Validate pinned lead-sheet request\").first().json; const result = (function formatLeadSheetBridgeResponse(request,response){\n if(request.operation==='write'){if(response.updatedRows!==1||response.updatedCells!==16)throw Error('Lead write acknowledgement unavailable');return {accepted:true};}\n const values=response.values??[];if(!Array.isArray(values)||values.length>999||values.some(row=>!Array.isArray(row)))throw Error('Lead response denied');\n if(request.operation==='locate')return{rows:values.flatMap((row,i)=>String(row[0]??'')===request.leadId?[i+2]:[]).slice(0,2)};\n if(values.length>1||(values[0]?.length??0)>16)throw Error('Lead response denied');\n const cells=(values[0]??[]).map(x=>String(x));if(cells.some(x=>x.length>2048))throw Error('Lead response denied');return{cells};\n})(request,$input.first().json); return [{json:result}];"}}});
+const reply=node({type:'n8n-nodes-base.respondToWebhook',version:1.4,config:{name:'Return result',parameters:{respondWith:'json',responseBody:expr('{{ $json }}'),options:{responseCode:200}}}});
+export default workflow('thaara-whatsapp-leads-sheet-v1','THAARA WhatsApp Leads — DISABLED review draft').add(start).to(guard).to(branch.onTrue(write.to(format.to(reply))).onFalse(read.to(format.to(reply))));
