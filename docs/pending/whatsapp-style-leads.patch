+/**
+ * Meta Cloud API error codes that represent genuine connection-wide / WABA / sender / billing / token failures
+ * (including Meta billing error 131042) rather than recipient-specific delivery failures.
+ */
+export const CONNECTION_WIDE_FAILURE_CODES: ReadonlySet<number> = new Set([
+  131042, // Business eligibility payment issue
+  131031, // Business account locked / restricted
+  131048, // Sender spam rate limit hit
+  130429, // Cloud API throughput rate limit hit
+  80007,  // WABA/App rate limit issue
+  4,      // Application request limit reached
+  190,    // Access token expired or invalid
+  368,    // Account temporarily blocked for policy violation
+  131000, // Something went wrong on provider side
+  131005, // Access denied / permission missing on sender
+  131008, // Required parameter missing in sender configuration
+  131016, // Service unavailable
+  133010  // Sender phone number not registered
+]);
+
+const CONNECTION_WIDE_FAILURE_TEXT_PATTERN =
+  /\b(?:payment|billing|eligibility|account\s+(?:locked|restricted|disabled|suspended)|access\s+token|permission\s+denied|spam\s+rate\s+limit|sender\s+not\s+registered)\b/i;
+
+export function isConnectionWideDeliveryFailure(
+  failure?: { code: number | null; title: string; details: string } | null
+): boolean {
+  if (!failure) return false;
+  if (failure.code !== null && CONNECTION_WIDE_FAILURE_CODES.has(failure.code)) return true;
+  return CONNECTION_WIDE_FAILURE_TEXT_PATTERN.test(`${failure.title} ${failure.details}`);
+}
