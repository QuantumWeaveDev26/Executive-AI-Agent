index 0000000..25cfe02
--- /dev/null
+++ b/apps/api/src/services/whatsapp-lead-job.ts
@@ -0,0 +1,27 @@
+import {hasLeadAuthorization,type LeadExecutionScope} from './whatsapp-lead-scope.js';
+import type {LeadTarget,WhatsAppLeadSync} from './whatsapp-lead-sync.js';
+import type {PostgresWhatsAppLeadRegister} from './whatsapp-lead-postgres.js';
+export interface WhatsAppLeadJobBinding{scope:LeadExecutionScope;connectionId:string;target:LeadTarget;approvalExpiresAt:number}
+/** Add this bounded callback to the existing approved job schedule. No new polling loop, credentials or fabricated user session. */
+export function createWhatsAppLeadJob(options:{enabled:boolean;resolveApprovedBinding:()=>Promise<WhatsAppLeadJobBinding|null>;register:Pick<PostgresWhatsAppLeadRegister,'captureConnection'>&Partial<Pick<PostgresWhatsAppLeadRegister,'diagnostics'>>;sync:Pick<WhatsAppLeadSync,'syncOne'>}){
+ return async()=>{
+  if(!options.enabled)return{status:'not_configured',projected:0,synced:0};
+  const binding=await options.resolveApprovedBinding();
+  if(!binding||!Number.isFinite(binding.approvalExpiresAt)||binding.approvalExpiresAt<=Date.now()||!hasLeadAuthorization(binding.scope))return{status:'awaiting_approval',projected:0,synced:0};
+  const scope={...binding.scope},target={...binding.target};let projected=0,synced=0,more=false;
+  // The existing queue invokes subsequent runs for backlog/retry; each invocation is bounded.
+  for(let page=0;page<4;page++){const result=await options.register.captureConnection(scope,binding.connectionId);projected+=result.projected;more=result.hasMore;if(!more)break;}
+  for(let item=0;item<10;item++){
+   if(binding.approvalExpiresAt<=Date.now())return{status:'awaiting_approval',projected,synced,backlog:more};
+   const result=await options.sync.syncOne(scope,binding.connectionId,target);
+   if(result.status==='idle'){
+    const states=options.register.diagnostics?(await options.register.diagnostics(scope,binding.connectionId)).rows:[];
+    const blocked=['unverified','inflight','failed','awaiting_approval'].find(state=>states.some(row=>row.sync_status===state&&Number(row.count)>0));
+    return{status:blocked??(more?'queued':'idle'),projected,synced,backlog:more};
+   }
+   if(result.status!=='synced')return{status:result.status,projected,synced,backlog:more};
+   synced++;
+  }
+  return{status:'queued',projected,synced,backlog:true};
+ };
+}
diff --git a/apps/api/src/services/whatsapp-lead-postgres.ts b/apps/api/src/services/whatsapp-lead-postgres.ts
new file mode 100644
index 0000000..f425d0d
--- /dev/null
+++ b/apps/api/src/services/whatsapp-lead-postgres.ts
@@ -0,0 +1,55 @@
+import type {DbClient,WhatsAppMessageRecord,WhatsAppDispatchRecord,WhatsAppStatusRecord} from '@thaara/db';
+import {whatsappDraftPreview,type MetaWhatsAppTestConfig} from '@thaara/contracts';
+import {buildWhatsAppLead,isLeadErasureRequest,type WhatsAppLead} from './whatsapp-lead-register.js';
+import type {LeadExecutionScope} from './whatsapp-lead-scope.js';
+export interface LeadDatabase{withScopedTransaction<T>(scope:LeadExecutionScope,operation:(tx:DbClient)=>Promise<T>):Promise<T>}
+export interface LeadRow{workspace_id:string;owner_user_id:string;connection_id:string;lead_id:string;sheet_row:string;payload:WhatsAppLead;version:string;sync_status:string;claim_token:string|null;attempts:number}
+/** Projection of the EXISTING durable inbox. No webhook/send or conversation-memory changes. */
+export class PostgresWhatsAppLeadRegister{
+ constructor(readonly db:LeadDatabase,private serviceViews=false){}
+ private source(name:'connections'|'messages'|'dispatches'|'status_events'){return this.serviceViews?'public.whatsapp_lead_source_'+name+'_v1':'public.whatsapp_n8n_'+name;}
+ async captureConnection(scope:LeadExecutionScope,connectionId:string){
+  scope={...scope};
+  return this.db.withScopedTransaction(scope,async tx=>{
+   const key=[scope.workspaceId,scope.userId,connectionId];
+   // Serialize projectors on their own lock, without holding the webhook's connection-row lock.
+   await tx.query(`SELECT pg_advisory_xact_lock(hashtextextended($1,0))`,[JSON.stringify(key)]);
+   const binding=(await tx.query<{binding:MetaWhatsAppTestConfig}>(`SELECT binding FROM ${this.source('connections')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 AND disconnected=false`,key)).rows[0]?.binding;
+   if(!binding||binding.workspaceId!==scope.workspaceId||binding.userId!==scope.userId||binding.connectionId!==connectionId)throw Error('Lead connection denied');
+   await tx.query(`INSERT INTO public.whatsapp_lead_projection_cursor_v1(workspace_id,owner_user_id,connection_id) VALUES($1,$2,$3) ON CONFLICT DO NOTHING`,key);
+   const cursor=(await tx.query<{last_message_id:string}>(`SELECT last_message_id FROM public.whatsapp_lead_projection_cursor_v1 WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 FOR UPDATE`,key)).rows[0]!.last_message_id;
+   const source=(await tx.query<{record:WhatsAppMessageRecord}>(`SELECT record FROM ${this.source('messages')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 AND provider_message_id>$4 ORDER BY provider_message_id LIMIT 251`,[...key,cursor])).rows;
+   const hasMore=source.length>250;const messages=source.slice(0,250).map(r=>r.record);
+   const dispatches=(await tx.query<{record:WhatsAppDispatchRecord}>(`SELECT record FROM ${this.source('dispatches')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 ORDER BY dispatch_id LIMIT 1001`,key)).rows.map(r=>r.record);
+   const events=(await tx.query<{record:WhatsAppStatusRecord}>(`SELECT record FROM ${this.source('status_events')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 LIMIT 2001`,key)).rows.map(r=>r.record);
+   const previous=(await tx.query<LeadRow>(`SELECT * FROM public.whatsapp_lead_register_v1 WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3`,key)).rows;
+   const groups=new Map<string,WhatsAppMessageRecord[]>();let unresolved=0;
+   for(const message of messages){
+    const phone=binding.recipients.find(r=>r.id===message.recipientId)?.phoneE164??(/^c_[1-9]\d{6,14}$/.test(message.recipientId)?'+'+message.recipientId.slice(2):'');
+    if(!/^\+[1-9]\d{6,14}$/.test(phone)){unresolved++;continue;}const group=groups.get(phone)??[];group.push(message);groups.set(phone,group);
+   }
+   let projected=0;
+   for(const[phone,group]of groups){
+    const recipientId=group.slice().sort((a,b)=>a.timestamp.localeCompare(b.timestamp)).at(-1)!.recipientId;
+    const recipientIds=[...new Set([...group.map(m=>m.recipientId),...binding.recipients.filter(r=>r.phoneE164===phone).map(r=>r.id),'c_'+phone.slice(1)])];
+    const earliest=(await tx.query<{first_contact:string}>(`SELECT min(record->>'timestamp') AS first_contact FROM ${this.source('messages')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 AND (record->>'recipientId')=ANY($4::text[])`,[...key,recipientIds])).rows[0]?.first_contact;
+    // Search the entire admitted history for an exact privacy request, even if it lies beyond this bounded page.
+    const privacy=(await tx.query<{record:WhatsAppMessageRecord}>(`SELECT record FROM ${this.source('messages')} WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 AND (record->>'recipientId')=ANY($4::text[]) AND ((record->>'textPreview') ~* $5 OR btrim(record->>'textPreview')=ANY($6::text[])) ORDER BY provider_message_id LIMIT 1`,[...key,recipientIds,'^(please\\s+)?(delete|erase|remove)\\s+(all\\s+)?my\\s+(data|details|information|record)[.!\\s]*$',['ನನ್ನ ಮಾಹಿತಿಯನ್ನು ಅಳಿಸಿ','ನನ್ನ ಡೇಟಾ ಅಳಿಸಿ','मेरा डेटा हटाएं','मेरी जानकारी हटाएं']])).rows.map(r=>r.record).filter(m=>isLeadErasureRequest(m.textPreview));
+    const admitted=[...group,...privacy].map(m=>({...m,recipientId}));
+    const first=buildWhatsAppLead({workspaceId:scope.workspaceId,userId:scope.userId,connectionId,recipientId,phoneE164:phone,messages:admitted,outbound:[],firstContact:earliest});
+    const outbound=dispatches.filter(d=>group.some(m=>m.recipientId===d.draft.recipientId)).map(d=>({text:whatsappDraftPreview(d.draft),verifiedSent:events.some(e=>e.providerMessageId===d.receipt.providerMessageId&&e.recipientAddress===phone.slice(1)&&['sent','delivered','read'].includes(e.status))}));
+    const payload=buildWhatsAppLead({workspaceId:scope.workspaceId,userId:scope.userId,connectionId,recipientId,phoneE164:phone,messages:admitted,outbound,previous:previous.find(r=>r.lead_id===first.id)?.payload,firstContact:earliest});
+    const changed=await tx.query(`INSERT INTO public.whatsapp_lead_register_v1(workspace_id,owner_user_id,connection_id,lead_id,payload) VALUES($1,$2,$3,$4,$5::jsonb)
+     ON CONFLICT(workspace_id,owner_user_id,connection_id,lead_id) DO UPDATE SET payload=excluded.payload,version=whatsapp_lead_register_v1.version+1,
+      sync_status=CASE WHEN whatsapp_lead_register_v1.sync_status IN ('inflight','unverified') THEN whatsapp_lead_register_v1.sync_status ELSE 'queued' END,
+      attempts=CASE WHEN whatsapp_lead_register_v1.sync_status IN ('inflight','unverified') THEN whatsapp_lead_register_v1.attempts ELSE 0 END,next_attempt_at=now()
+     WHERE whatsapp_lead_register_v1.payload IS DISTINCT FROM excluded.payload RETURNING lead_id`,[...key,payload.id,JSON.stringify(payload)]);
+    projected+=changed.rows.length;
+   }
+   await tx.query(`UPDATE public.whatsapp_lead_projection_cursor_v1 SET last_message_id=$4 WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3`,[...key,hasMore?messages.at(-1)!.providerMessageId:'']);
+   return{projected,unresolved,hasMore};
+  });
+ }
+ async diagnostics(scope:LeadExecutionScope,connectionId:string){return this.db.withScopedTransaction(scope,tx=>tx.query<{sync_status:string;count:string}>(`SELECT sync_status,count(*)::text AS count FROM public.whatsapp_lead_register_v1 WHERE workspace_id=$1 AND owner_user_id=$2 AND connection_id=$3 GROUP BY sync_status`,[scope.workspaceId,scope.userId,connectionId]));}
+}
+export async function auditLead(tx:DbClient,row:LeadRow,outcome:string){await tx.query(`INSERT INTO public.whatsapp_lead_sync_audit_v1(workspace_id,owner_user_id,connection_id,lead_id,version,outcome) VALUES($1,$2,$3,$4,$5,$6)`,[row.workspace_id,row.owner_user_id,row.connection_id,row.lead_id,row.version,outcome]);}
diff --git a/apps/api/src/services/whatsapp-lead-register.ts b/apps/api/src/services/whatsapp-lead-register.ts
new file mode 100644
index 0000000..35cf942
--- /dev/null
+++ b/apps/api/src/services/whatsapp-lead-register.ts
@@ -0,0 +1,57 @@
+import {createHash} from 'node:crypto';
+import {buildConversationMemoryState,DIRECT_CALENDLY_URL} from './whatsapp-enquiries.js';
+export const LEAD_HEADERS=['First Contact','Last Contact','Customer Name','WhatsApp Number','Business Name','Business Type','Service Interested In','Customer Requirement','Lead Status','Calendly Link Shared','Appointment Status','Last Customer Message','Follow-Up Notes','Conversation ID','Internal Lead ID','Sync Version'] as const;
+export interface WhatsAppLead{
+ id:string;firstContact:string;lastContact:string;name:string;phone:string;businessName:string;businessType:string;service:string;requirement:string;
+ status:'New'|'In Conversation'|'Interested'|'Not Interested'|'Call Requested';calendlyShared:boolean;appointment:'Unknown'|'Requested'|'Booked'|'Confirmed';lastMessage:string;notes:string;conversationId:string;erased:boolean;
+}
+export interface WhatsAppLeadInput{
+ workspaceId:string;userId:string;connectionId:string;recipientId:string;phoneE164:string;
+ messages:Array<{providerMessageId:string;recipientId:string;textPreview:string;timestamp:string}>;
+ outbound:Array<{text:string;verifiedSent:boolean}>;previous?:WhatsAppLead;
+ firstContact?:string;
+}
+const compact=(value:unknown,max=500)=>typeof value==='string'?value.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g,'').trim().slice(0,max):'';
+export function buildWhatsAppLead(input:WhatsAppLeadInput):WhatsAppLead{
+ if(!/^\+[1-9]\d{6,14}$/.test(input.phoneE164))throw Error('Lead sender unavailable');
+ const id=createHash('sha256').update(JSON.stringify([input.workspaceId,input.connectionId,input.phoneE164])).digest('hex');
+ if(input.previous&&input.previous.id!==id)throw Error('Lead scope mismatch');
+ const messages=input.messages.filter(m=>m.recipientId===input.recipientId).map(m=>({...m,timestamp:new Date(m.timestamp).toISOString()})).sort((a,b)=>a.timestamp.localeCompare(b.timestamp)||a.providerMessageId.localeCompare(b.providerMessageId));
+ if(!messages.length)throw Error('Accepted inbound message required');
+ const first=messages[0]!,latest=messages[messages.length-1]!,previous=input.previous;
+ if(previous?.erased)return previous;
+ const row:WhatsAppLead=previous?{...previous}:{id,firstContact:input.firstContact?new Date(input.firstContact).toISOString():first.timestamp,lastContact:latest.timestamp,name:'',phone:input.phoneE164,businessName:'',businessType:'',service:'',requirement:'',status:'New',calendlyShared:false,appointment:'Unknown',lastMessage:'',notes:'',conversationId:`${input.connectionId}:${input.recipientId}`,erased:false};
+ const text=latest.textPreview.trim();
+ // Only explicit sender privacy requests; never an assistant/tool instruction or tenant claim.
+ if(messages.some(m=>isLeadErasureRequest(m.textPreview))){
+  return {...row,name:'',phone:'',businessName:'',businessType:'',service:'',requirement:'',lastMessage:'',notes:'',conversationId:'',calendlyShared:false,appointment:'Unknown',erased:true,lastContact:latest.timestamp};
+ }
+ const memory=buildConversationMemoryState({connectionId:input.connectionId,recipientId:input.recipientId,maskedPhone:'[not-displayed]',messages:messages.map(m=>({...m,direction:'inbound' as const}))});
+ // Older pages may fill an unknown field, but never replace a newer known value.
+ row.name ||= compact(memory.customerName||memory.priorCustomerName,100);
+ row.businessName ||= compact(memory.businessName||memory.priorBusinessName,160);
+ row.businessType ||= compact(memory.businessType||memory.businessCategory||memory.priorBusinessType,160);
+ row.service ||= compact(memory.interestedService,200);
+ row.requirement ||= compact(memory.customerRequirements);
+ if(latest.timestamp>=row.lastContact){
+  row.lastContact=latest.timestamp;row.lastMessage=compact(text,1000);
+  row.name=compact(memory.customerName||memory.priorCustomerName,100)||row.name;
+  row.businessName=compact(memory.businessName||memory.priorBusinessName,160)||row.businessName;
+  row.businessType=compact(memory.businessType||memory.businessCategory||memory.priorBusinessType,160)||row.businessType;
+  row.service=compact(memory.interestedService,200)||row.service;
+  row.requirement=compact(memory.customerRequirements)||row.requirement;
+  if(/^(?:stop|unsubscribe|opt\s*out)[.!\s]*$|\b(?:not interested|do not contact|don't contact)\b/i.test(text))row.status='Not Interested';
+  else if(/\b(?:arrange|request|schedule|book|want|need)\b.{0,35}\bcall\b|\bspeak\s+(?:with|to)\s+(?:your|the)\s+team\b/i.test(text)){row.status='Call Requested';if(row.appointment==='Unknown')row.appointment='Requested';}
+  else if(/\b(?:interested in|looking for|want to|need an?|need help)\b/i.test(text)&&! /\b(?:not interested|do not need|don't need)\b/i.test(text))row.status='Interested';
+  else if(row.status==='New'&&(messages.length>1||row.name||row.businessType||row.service))row.status='In Conversation';
+ }
+ row.calendlyShared ||= input.outbound.some(m=>m.verifiedSent&&m.text.includes(DIRECT_CALENDLY_URL));
+ // A link or a customer's booking claim is never verified booking evidence.
+ return row;
+}
+export function isLeadErasureRequest(text:string){return /^(?:please\s+)?(?:delete|erase|remove)\s+(?:all\s+)?my\s+(?:data|details|information|record)[.!\s]*$/i.test(text.trim())||['ನನ್ನ ಮಾಹಿತಿಯನ್ನು ಅಳಿಸಿ','ನನ್ನ ಡೇಟಾ ಅಳಿಸಿ','मेरा डेटा हटाएं','मेरी जानकारी हटाएं'].includes(text.trim());}
+export function leadCells(row:WhatsAppLead,version:number):string[]{
+ const safe=(value:unknown)=>{const text=String(value??'');return /^[\s]*[=+@-]/.test(text)?"'"+text:text;};
+ if(row.erased)return Array.from({length:16},(_,i)=>i===14?row.id:i===15?String(version):'');
+ return [row.firstContact,row.lastContact,row.name,row.phone,row.businessName,row.businessType,row.service,row.requirement,row.status,row.calendlyShared?'Yes':'No',row.appointment,row.lastMessage,row.notes,row.conversationId,row.id,String(version)].map((value,index)=>index===3?row.phone:safe(value));
+}
diff --git a/apps/api/src/services/whatsapp-lead-runtime.ts b/apps/api/src/services/whatsapp-lead-runtime.ts
