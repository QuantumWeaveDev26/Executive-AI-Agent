+ it('refuses an expired or missing approved owner binding',async()=>{const register={captureConnection:vi.fn()},sync={syncOne:vi.fn()};for(const selected of[null,{...binding,approvalExpiresAt:0}]){const run=createWhatsAppLeadJob({enabled:true,resolveApprovedBinding:async()=>selected,register,sync});expect((await run()).status).toBe('awaiting_approval');}expect(register.captureConnection).not.toHaveBeenCalled();});
+ it('caps each invocation at four capture pages and ten verified writes',async()=>{const register={captureConnection:vi.fn(async()=>({projected:1,unresolved:0,hasMore:true}))},sync={syncOne:vi.fn(async()=>({status:'synced',verified:true}))};const result=await createWhatsAppLeadJob({enabled:true,resolveApprovedBinding:async()=>binding,register,sync})();expect(register.captureConnection).toHaveBeenCalledTimes(4);expect(sync.syncOne).toHaveBeenCalledTimes(10);expect(result).toMatchObject({status:'queued',projected:4,synced:10});});
+ it('stops on an uncertain outcome instead of treating it as verified delivery',async()=>{const register={captureConnection:vi.fn(async()=>({projected:1,unresolved:0,hasMore:false}))},sync={syncOne:vi.fn(async()=>({status:'unverified',verified:false}))};expect(await createWhatsAppLeadJob({enabled:true,resolveApprovedBinding:async()=>binding,register,sync})()).toMatchObject({status:'unverified',synced:0});expect(sync.syncOne).toHaveBeenCalledOnce();});
+ it('reports durable blocked rows instead of false idle success',async()=>{const register={captureConnection:vi.fn(async()=>({projected:0,unresolved:0,hasMore:false})),diagnostics:vi.fn(async()=>({rows:[{sync_status:'unverified',count:'1'}]}))},sync={syncOne:vi.fn(async()=>({status:'idle'}))};expect(await createWhatsAppLeadJob({enabled:true,resolveApprovedBinding:async()=>binding,register,sync})()).toMatchObject({status:'unverified',synced:0});});
+
+});
