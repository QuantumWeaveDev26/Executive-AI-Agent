@@ -0,0 +1,18 @@
+/** Pure, fixed-target bridge logic. No credentials or network calls in Code nodes. */
+export function validateLeadSheetBridgeBody(body){
+ const target='1Roo0IaLx5flncIiESj5QqiOtNWqpZgnAuSsnWAyo3QQ',sheet='WhatsApp Enquiries';
+ if(!body||Array.isArray(body)||typeof body!=='object'||Object.keys(body).some(k=>!['operation','spreadsheetId','sheetName','row','cells','leadId','valueInputOption'].includes(k)))throw Error('Lead request denied');
+ if(body.spreadsheetId!==target||body.sheetName!==sheet||!['read','write','locate'].includes(body.operation)||!Number.isSafeInteger(body.row)||body.row<1||body.row>1000)throw Error('Lead request denied');
+ if(body.operation==='write'&&(body.row===1||body.valueInputOption!=='RAW'||!Array.isArray(body.cells)||body.cells.length!==16||body.cells.some(x=>typeof x!=='string'||x.length>2048)))throw Error('Lead write denied');
+ if(body.operation==='locate'&&!/^[a-f0-9]{64}$/.test(body.leadId??''))throw Error('Lead lookup denied');
+ const range=body.operation==='locate'?"'WhatsApp Enquiries'!O2:O1000":"'WhatsApp Enquiries'!A"+body.row+':P'+body.row;
+ return {operation:body.operation,row:body.row,cells:body.operation==='write'?body.cells:[],leadId:body.operation==='locate'?body.leadId:'',googleUrl:'https://sheets.googleapis.com/v4/spreadsheets/'+target+'/values/'+encodeURIComponent(range)+(body.operation==='write'?'?valueInputOption=RAW':'')};
+}
+export function formatLeadSheetBridgeResponse(request,response){
+ if(request.operation==='write'){if(response.updatedRows!==1||response.updatedCells!==16)throw Error('Lead write acknowledgement unavailable');return {accepted:true};}
+ const values=response.values??[];if(!Array.isArray(values)||values.length>999||values.some(row=>!Array.isArray(row)))throw Error('Lead response denied');
+ if(request.operation==='locate')return{rows:values.flatMap((row,i)=>String(row[0]??'')===request.leadId?[i+2]:[]).slice(0,2)};
+ if(values.length>1||(values[0]?.length??0)>16)throw Error('Lead response denied');
+ const cells=(values[0]??[]).map(x=>String(x));if(cells.some(x=>x.length>2048))throw Error('Lead response denied');return{cells};
+}
+export function leadBridgeCode(){return{guard:'const approved = ('+validateLeadSheetBridgeBody.toString()+')($input.first().json.body); return [{json: approved}];',response:'const request = $("Validate pinned lead-sheet request").first().json; const result = ('+formatLeadSheetBridgeResponse.toString()+')(request,$input.first().json); return [{json:result}];'};}
