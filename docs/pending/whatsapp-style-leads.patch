+    { label: 'consulting', pattern: /\b(?:consulting|consultancy|agency|marketing\s+firm)\b|ಏಜೆನ್ಸಿ|एजेंसी|सलाह/i },
+    { label: 'ecommerce', pattern: /\b(?:e-?commerce|online\s+store|d2c|shopify)\b|ಇ-ಕಾಮರ್ಸ್|ई-कॉमर्स/i },
+    { label: 'manufacturing', pattern: /\b(?:manufacturing|factory|wholesale|distributor)\b|ಕಾರ್ಖಾನೆ|ಫ್ಯಾಕ್ಟರಿ|फैक्ट्री/i },
