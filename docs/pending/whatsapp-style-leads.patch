+export function detectCustomerMessageLanguage(text: string): WhatsAppCustomerLanguage {
+  if (/[\u0C80-\u0CFF]/.test(text)) return 'kn';
+  if (/[\u0900-\u097F]/.test(text)) return 'hi';
+  if (/\b(?:namaskara|hegiddira|mahiti|beku|madbeku|maadi|madi|kodi|heliri|heli|nale|indhu|seve|namge|nimma)\b/i.test(text)) {
+    return 'kn';
+  }
+  if (/\b(?:namaste|kripaya|chahiye|bataiye|bataye|jankari|humare|hamare|aapse|karein|humein|hume)\b/i.test(text)) {
+    return 'hi';
+  }
+  return 'en';
+}
+
+function cleanSnippet(value: string, maxLen = 120): string {
+  return sanitizeWhatsAppText(value)
+    .replace(/\+?\d{7,}/g, '[number]')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, maxLen);
+}
+
+function formatProperName(name: string): string {
+  return name
+    .trim()
+    .split(/\s+/)
+    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
+    .join(' ');
+}
+
+export function extractCustomerName(
+  texts: string[],
+  fallbackName?: string,
+  lastQuestionAsked?: WhatsAppConversationQuestionTopic,
+  messages?: Array<{ direction: 'inbound' | 'outbound'; textPreview: string }>
+): string | undefined {
+  // 1. Explicit key-value label: e.g. "name krishna", "name: krishna", "ಹೆಸರು: ಕೃಷ್ಣ", "नाम: कृष्णा"
+  for (const text of texts) {
+    const labelMatch =
+      /(?:^|\n|[;,\r])\s*(?:name|ಹೆಸರು|नाम)\s*[:\-]?\s*([A-Za-z\u0C80-\u0CFF\u0900-\u097F][A-Za-z\u0C80-\u0CFF\u0900-\u097F ]{1,30}?)(?=\s*(?:[\r\n;,]|$|\b(?:business|company|firm|email|mail|ವ್ಯವಹಾರ|ಇಮೇಲ್|व्यवसाय|ईमेल)\b))/i.exec(
+        text
+      );
+    if (labelMatch?.[1]) {
+      const candidate = labelMatch[1].trim();
+      if (isRealCustomerName(candidate)) return formatProperName(candidate);
+    }
+  }
+
+  // 2. Standard introduction phrases: "my name is Krishna", "I am Krishna", "this is Krishna"
+  for (const text of texts) {
+    const match =
+      /\b(?:my\s+name\s+is|i\s+am|this\s+is)\s+([A-Za-z\u0C80-\u0CFF\u0900-\u097F]{2,25}(?:\s+[A-Za-z\u0C80-\u0CFF\u0900-\u097F]{2,25})?)(?=\s+(?:from|with|at|and|in)\b|[,.;!?\n]|$)/i.exec(text) ??
+      /(?:ನನ್ನ\s+ಹೆಸರು|ನಾನು)\s+([^\s,.!?;:\n]{2,30})/i.exec(text) ??
+      /(?:मेरा\s+नाम)\s+([^\s,.!?;:\n]{2,30})/i.exec(text);
+    if (match?.[1]) {
+      const candidate = cleanSnippet(match[1], 60);
+      const stopWords = /^(?:interested|looking|calling|messaging|writing|asking|from|running|having|facing|need|want|here|fine|good|thaara|quantum|business)$/i;
+      if (candidate && !stopWords.test(candidate.split(/\s+/)[0] ?? '') && isRealCustomerName(candidate)) {
+        return formatProperName(candidate);
+      }
+    }
+  }
+
+  // 3. Paired conversation turns: outbound prompted for name (or name, business, email) followed by customer reply
+  if (messages && messages.length >= 2) {
+    for (let i = 0; i < messages.length - 1; i++) {
+      const curr = messages[i]!;
+      const next = messages[i + 1]!;
+      if (curr.direction === 'outbound' && next.direction === 'inbound') {
+        const askedName =
+          /\b(?:may\s+i\s+(?:know|have)\s+your\s+name|what\s+is\s+your\s+name|could\s+you\s+share\s+your\s+name|share\s+your\s+name)\b/i.test(curr.textPreview) ||
+          /ನಿಮ್ಮ\s+ಹೆಸರು|आपका\s+नाम/i.test(curr.textPreview);
+        if (askedName) {
+          // Check line by line to handle multi-line inputs e.g. "krishna\nexample@gmail.com"
+          const lines = next.textPreview.split(/[\r\n]+/).map(l => l.trim()).filter(Boolean);
+          for (const line of lines) {
+            // Skip lines containing email, URL, business keywords
+            if (/@/.test(line) || /\.(?:com|in|org|net)\b/i.test(line)) continue;
+            if (/\b(?:business|company|clothing|fashion|clinic|hospital|store|shop|automation|consultation|appointment)\b/i.test(line)) continue;
+            // Check for label on the line
+            const lineLabelMatch = /^(?:name|ಹೆಸರು|नाम)\s*[:\-]?\s*([A-Za-z\u0C80-\u0CFF\u0900-\u097F\s]{2,30})$/i.exec(line);
+            const lineCand = lineLabelMatch?.[1]?.trim() ?? line.replace(/[.!?]+$/, '').trim();
+            const words = lineCand.split(/\s+/);
+            if (words.length >= 1 && words.length <= 3 && !/^(?:hi|hello|hey|yes|no|ok|okay)\b/i.test(lineCand)) {
+              const candidate = cleanSnippet(lineCand, 50);
+              if (isRealCustomerName(candidate)) return formatProperName(candidate);
+            }
+          }
+        }
+      }
+    }
+  }
+
+  // 4. Last question asked was customer_name
+  if (lastQuestionAsked === 'customer_name') {
+    for (const text of texts) {
+      const lines = text.split(/[\r\n]+/).map(l => l.trim()).filter(Boolean);
+      for (const line of lines) {
+        if (/@/.test(line) || /\.(?:com|in|org|net)\b/i.test(line)) continue;
+        if (/\b(?:business|company|clothing|fashion|clinic|hospital|store|shop|automation|consultation|appointment)\b/i.test(line)) continue;
+        const words = line.split(/\s+/);
+        if (words.length >= 1 && words.length <= 3 && !/^(?:hi|hello|hey|yes|no|ok|okay)\b/i.test(line)) {
+          const candidate = cleanSnippet(line.replace(/[.!?]+$/, ''), 50);
+          if (isRealCustomerName(candidate)) return formatProperName(candidate);
+        }
+      }
+    }
+  }
+
+  return fallbackName && isRealCustomerName(fallbackName) ? formatProperName(cleanSnippet(fallbackName, 80)) : undefined;
+}
+
+function extractBusinessName(texts: string[]): string | undefined {
+  for (const text of texts) {
+    const labelMatch =
+      /(?:^|\n|[;,\r])\s*(?:business(?:\s+name)?|company(?:\s+name)?|firm|ವ್ಯವಹಾರದ\s+ಹೆಸರು|ವ್ಯವಹಾರ|व्यवसाय\s+का\s+नाम|व्यवसाय)\s*[:\-]?\s*([A-Za-z0-9&.' \u0C80-\u0CFF\u0900-\u097F]{2,50}?)(?=\s*(?:[\r\n;,]|$|\b(?:email|mail|name|ಇಮೇಲ್|ईमेल)\b))/i.exec(
+        text
+      );
+    if (labelMatch?.[1]) {
+      const cleaned = cleanSnippet(labelMatch[1], 80);
+      if (cleaned.length >= 2 && !/@/.test(cleaned)) return cleaned;
+    }
+    const match =
+      /\b(?:my\s+(?:business|company|firm|clinic|store|shop|agency|brand|startup)\s+(?:name\s+)?is|we\s+are\s+from|calling\s+from|messaging\s+from|founder\s+of|owner\s+of|run\s+a\s+(?:business|company|clinic|store|shop|agency)\s+called|(?:my\s+name\s+is|i\s+am|this\s+is)\s+[A-Z][a-z]{1,25}(?:\s+[A-Z][a-z]{1,25})?\s+from)\s+([A-Za-z0-9&.' -]{2,50}?)(?=[,.;!?\n]|$|\s+(?:and|we|looking|need|want|in\b))/i.exec(
+        text
+      );
+    if (match?.[1]) {
+      const cleaned = cleanSnippet(match[1], 80);
+      if (cleaned.length >= 2 && !/@/.test(cleaned)) return cleaned;
+    }
+  }
+  return undefined;
+}
