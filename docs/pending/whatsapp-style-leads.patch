+import {describe,it,expect,vi} from 'vitest';
+import {formatWhatsAppMobileReply,WHATSAPP_MOBILE_STYLE} from '../src/services/whatsapp-mobile-style';
+import {WhatsAppAIService,buildThaaraIntroduction} from '../src/services/whatsapp-ai-service';
+describe('WhatsApp mobile-only replies',()=>{
+ it('introduces new contacts with the requested short English greeting',()=>{
+  expect(buildThaaraIntroduction('en')).toBe("Hi! I'm Thaara, an AI assistant from Quantum Weave AI.\n\nHow can I help you today?");
+ });
+ it('formats lists and headings without truncating technical content or altering Calendly',()=>{
+  const link='https://calendly.com/team-brandmint/30min';
+  expect(formatWhatsAppMobileReply('**Our services:**\n1. AI Assistants\n2. Digital Marketing\n\n'+link)).toBe('Our services:\n• AI Assistants\n• Digital Marketing\n\n'+link);
+  const long='Necessary technical detail. '.repeat(60);expect(formatWhatsAppMobileReply(long)).toContain(long.trim());
+  const json='{"tool":"run","text":"**raw**"}';expect(formatWhatsAppMobileReply(json)).toBe(json);expect(WHATSAPP_MOBILE_STYLE).toContain('10–35');
+ });
+ it('does not reset a returning customer whose introduction survives in memory',async()=>{
+  const streamResponse=vi.fn(async function*(){yield{type:'token',delta:'Welcome back. How is your clothing business?'};});
+  const service=new WhatsAppAIService({streamResponse} as any);
+  const result=await service.generateCustomerReply({connectionId:'connection',recipientId:'customer',phoneE164:'+919876543210',latestCustomerMessage:'Hi',conversationHistory:[],memory:{introducedCompany:true} as any});
+  expect(streamResponse).toHaveBeenCalledOnce();expect(result.replyText).not.toContain("I'm Thaara");
+ });
+});
