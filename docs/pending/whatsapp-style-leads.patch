+    { label: 'bakery', pattern: /\b(?:bakery|bakes?|pastr(?:y|ies)|cakes?|sweets?)\b|ಬೇಕರಿ|बेकरी/i },
+    { label: 'restaurant', pattern: /\b(?:restaurant|cafe|hotel|food|catering|eatery|dining)\b|ಹೋಟೆಲ್|ರೆಸ್ಟೋರೆಂಟ್|होटल|रेस्तरां/i },
