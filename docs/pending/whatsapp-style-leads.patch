+import {describe,it,expect,vi} from 'vitest';
+const state=vi.hoisted(()=>({queues:[] as any[],workers:[] as any[]}));
+vi.mock('ioredis',()=>({Redis:class{status='ready';on(){return this;}async quit(){this.status='end';}}}));
+vi.mock('bullmq',()=>({Queue:class{constructor(name:string,opts:any){state.queues.push({name,opts});}async add(...args:any[]){state.queues.at(-1).added=args;}async close(){}on(){return this;}},Worker:class{constructor(name:string,run:any){state.workers.push({name,run});}on(){return this;}async close(){}}}));
+import {DistributedJobQueue} from '../src/queue';
+describe('isolated lead queue reuses existing BullMQ implementation',()=>{
+ it('requires a handler, uses only the lead namespace, never constructs shared sweepers and rejects unrelated jobs',async()=>{
+  expect(()=>new DistributedJobQueue('redis://synthetic',null,undefined,undefined,undefined,true)).toThrow('configuration');
+  const handler=vi.fn(async()=>({success:false,result:{status:'awaiting_approval'}}));const queue=new DistributedJobQueue('redis://synthetic',null,undefined,undefined,handler,true);
+  await queue.scheduleWhatsAppLeads({workspaceId:'workspace',connectionId:'connection'});queue.startWorker();expect(state.queues.at(-1).name).toBe('thaara-whatsapp-leads');expect(state.workers.at(-1).name).toBe('thaara-whatsapp-leads');
+  const run=state.workers.at(-1).run;expect(await run({data:{jobName:'phone.call'}})).toMatchObject({success:false,result:{status:'denied'}});expect(handler).not.toHaveBeenCalled();await run({data:{jobName:'whatsapp.leads.sync'}});expect(handler).toHaveBeenCalledOnce();await queue.close();
+ });
+ it('sanitizes callback failures before any queue error listener can log them',async()=>{
+  const queue=new DistributedJobQueue('redis://synthetic',null,undefined,undefined,async()=>{throw Error('synthetic-private-value');},true);queue.startWorker();await expect(state.workers.at(-1).run({data:{jobName:'whatsapp.leads.sync'}})).rejects.toThrow('WhatsApp lead job is unavailable.');await queue.close();
+ });
+});
