+ALTER TABLE public.whatsapp_lead_register_v1 FORCE ROW LEVEL SECURITY;
+CREATE POLICY whatsapp_lead_register_v1_scope ON public.whatsapp_lead_register_v1
+ USING(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid)
+ WITH CHECK(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid);
+CREATE TABLE public.whatsapp_lead_sync_audit_v1 (
+ id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,workspace_id uuid NOT NULL,owner_user_id uuid NOT NULL,
+ connection_id text NOT NULL,lead_id text NOT NULL CHECK(lead_id ~ '^[a-f0-9]{64}$'),version bigint NOT NULL,
+ outcome text NOT NULL CHECK(outcome IN ('claimed','awaiting_approval','synced','retry','unverified','failed')),
+ created_at timestamptz NOT NULL DEFAULT now()
+);
+ALTER TABLE public.whatsapp_lead_sync_audit_v1 ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.whatsapp_lead_sync_audit_v1 FORCE ROW LEVEL SECURITY;
+CREATE POLICY whatsapp_lead_sync_audit_v1_scope ON public.whatsapp_lead_sync_audit_v1
+ USING(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid)
+ WITH CHECK(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid);
+REVOKE ALL ON public.whatsapp_lead_register_v1, public.whatsapp_lead_sync_audit_v1 FROM PUBLIC;
+CREATE TABLE public.whatsapp_lead_projection_cursor_v1(
+ workspace_id uuid NOT NULL,owner_user_id uuid NOT NULL,connection_id text NOT NULL,last_message_id text NOT NULL DEFAULT '',
+ PRIMARY KEY(workspace_id,owner_user_id,connection_id)
+);
+ALTER TABLE public.whatsapp_lead_projection_cursor_v1 ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.whatsapp_lead_projection_cursor_v1 FORCE ROW LEVEL SECURITY;
+CREATE POLICY whatsapp_lead_projection_cursor_v1_scope ON public.whatsapp_lead_projection_cursor_v1
+ USING(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid)
+ WITH CHECK(workspace_id=NULLIF(current_setting('app.workspace_id',true),'')::uuid AND owner_user_id=NULLIF(current_setting('app.user_id',true),'')::uuid);
