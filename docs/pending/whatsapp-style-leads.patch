+import {beforeAll,afterAll,beforeEach,describe,it,expect,vi} from 'vitest';
+import {readFileSync} from 'node:fs';
+import {PGliteDatabase} from '@thaara/db';
+import {PostgresWhatsAppLeadRegister} from '../src/services/whatsapp-lead-postgres';
+import {WhatsAppLeadSync,LEAD_SYNC_ACTION} from '../src/services/whatsapp-lead-sync';
+import {createWhatsAppLeadRuntime,WHATSAPP_LEAD_TARGET} from '../src/services/whatsapp-lead-runtime';
+import {LEAD_HEADERS} from '../src/services/whatsapp-lead-register';
+const scope={workspaceId:'10000000-0000-4000-8000-000000000001',userId:'10000000-0000-4000-8000-000000000002',role:'owner' as const,sessionTokenHash:'synthetic-local-session'};
+let db:PGliteDatabase;const connection='lead-test-connection';const target={spreadsheetId:'synthetic-spreadsheet-id',sheetName:'WhatsApp Enquiries' as const};
+const binding={workspaceId:scope.workspaceId,userId:scope.userId,connectionId:connection,recipients:[]};
+async function inbound(id:string,text:string,number='919876543210',time='2026-11-17T08:00:00Z'){
+ const record={providerMessageId:id,recipientId:'c_'+number,textPreview:text,timestamp:time};
+ await db.query(`INSERT INTO whatsapp_n8n_messages VALUES($1,$2,$3,$4,$5) ON CONFLICT DO NOTHING`,[scope.workspaceId,scope.userId,connection,id,JSON.stringify(record)]);
+}
+const approve=async(_tx:any,_scope:any,params:any)=>({id:'20000000-0000-4000-8000-000000000001',workspaceId:scope.workspaceId,requesterUserId:scope.userId,approverUserId:scope.userId,actionName:LEAD_SYNC_ACTION,actionParams:params,status:'approved' as const,riskLevel:'high' as const,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),expiresAt:new Date(Date.now()+60000).toISOString()});
+describe('isolated durable lead register and governed Sheets writer',()=>{
+ beforeAll(async()=>{
+  db=new PGliteDatabase();await db.exec(`CREATE TABLE whatsapp_n8n_connections(workspace_id uuid,owner_user_id uuid,connection_id text,binding jsonb,disconnected boolean);CREATE TABLE whatsapp_n8n_messages(workspace_id uuid,owner_user_id uuid,connection_id text,provider_message_id text,record jsonb,PRIMARY KEY(workspace_id,owner_user_id,connection_id,provider_message_id));CREATE TABLE whatsapp_n8n_dispatches(workspace_id uuid,owner_user_id uuid,connection_id text,dispatch_id text,record jsonb);CREATE TABLE whatsapp_n8n_status_events(workspace_id uuid,owner_user_id uuid,connection_id text,record jsonb);`);
+  await db.exec(readFileSync('docs/integrations/whatsapp/whatsapp-lead-register-v1.review.sql','utf8'));
+ },30000);
+ afterAll(async()=>{await db.close();});
+ beforeEach(async()=>{await db.exec('TRUNCATE whatsapp_n8n_connections,whatsapp_n8n_messages,whatsapp_n8n_dispatches,whatsapp_n8n_status_events,whatsapp_lead_register_v1,whatsapp_lead_sync_audit_v1,whatsapp_lead_projection_cursor_v1 RESTART IDENTITY');await db.query('INSERT INTO whatsapp_n8n_connections VALUES($1,$2,$3,$4,false)',[scope.workspaceId,scope.userId,connection,JSON.stringify(binding)]);});
+ it('runs the composed inbox-to-policy-to-bridge path and verifies one progressive row offline',async()=>{
+  await inbound('one','Hi');const rows=new Map<number,string[]>();let writes=0;
+  const network=vi.fn(async(_url:any,options:any)=>{
+   const request=JSON.parse(options.body);expect(request.spreadsheetId).toBe(WHATSAPP_LEAD_TARGET.spreadsheetId);
+   if(request.operation==='locate')return Response.json({rows:[...rows].filter(([,cells])=>cells[14]===request.leadId).map(([row])=>row)});
+   if(request.operation==='read')return Response.json({cells:request.row===1?[...LEAD_HEADERS]:rows.get(request.row)??[]});
+   expect(request.valueInputOption).toBe('RAW');writes++;rows.set(request.row,request.cells);return Response.json({accepted:true});
+  });
+  const run=createWhatsAppLeadRuntime({enabled:true,db,resolveApprovedBinding:async()=>({scope,connectionId:connection,target:WHATSAPP_LEAD_TARGET,approvalExpiresAt:Date.now()+60000}),resolveBridgeSecret:async()=>'x'.repeat(64),approvalFor:approve,fetch:network as any});
+  expect(await run()).toMatchObject({status:'idle',synced:1});expect(rows.size).toBe(1);expect(writes).toBe(1);
+  await inbound('two','My name is Krishna','919876543210','2026-11-17T09:00:00Z');expect(await run()).toMatchObject({synced:1});expect(rows.size).toBe(1);expect([...rows.values()][0][2]).toBe('Krishna');expect(writes).toBe(2);
+  expect(await run()).toMatchObject({synced:0});expect(writes).toBe(2);
+ });
+ it('keeps composed runtime disabled and denies a different sheet without resolving secrets or using the database',async()=>{
+  const resolveBridgeSecret=vi.fn(),resolveApprovedBinding=vi.fn(async()=>({scope,connectionId:connection,target,approvalExpiresAt:Date.now()+60000}));
+  expect(await createWhatsAppLeadRuntime({enabled:false,db,resolveApprovedBinding,resolveBridgeSecret})()).toMatchObject({status:'not_configured'});expect(resolveApprovedBinding).not.toHaveBeenCalled();
+  expect(await createWhatsAppLeadRuntime({enabled:true,db,resolveApprovedBinding,resolveBridgeSecret})()).toMatchObject({status:'awaiting_approval'});expect(resolveBridgeSecret).not.toHaveBeenCalled();
+ });
