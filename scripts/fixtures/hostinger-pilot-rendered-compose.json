{
 "name": "thaara-v2-pilot",
 "networks": {
  "data": {
   "name": "thaara-v2-pilot-data",
   "ipam": {},
   "internal": true
  },
  "entry": {
   "name": "thaara-v2-pilot-entry",
   "ipam": {}
  }
 },
 "secrets": {
  "admin_password": {
   "name": "thaara-v2-pilot_admin_password",
   "file": "/opt/thaara-v2-pilot-private/secrets/admin_password"
  },
  "api_password": {
   "name": "thaara-v2-pilot_api_password",
   "file": "/opt/thaara-v2-pilot-private/secrets/api_password"
  },
  "csrf_secret": {
   "name": "thaara-v2-pilot_csrf_secret",
   "file": "/opt/thaara-v2-pilot-private/secrets/csrf_secret"
  },
  "redis_password": {
   "name": "thaara-v2-pilot_redis_password",
   "file": "/opt/thaara-v2-pilot-private/secrets/redis_password"
  },
  "session_secret": {
   "name": "thaara-v2-pilot_session_secret",
   "file": "/opt/thaara-v2-pilot-private/secrets/session_secret"
  }
 },
 "services": {
  "api": {
   "profiles": [
    "application"
   ],
   "cap_drop": [
    "ALL"
   ],
   "cpus": 0.5,
   "command": null,
   "depends_on": {
    "postgres": {
     "condition": "service_healthy",
     "required": true
    },
    "redis": {
     "condition": "service_healthy",
     "required": true
    }
   },
   "entrypoint": null,
   "environment": {
    "NODE_ENV": "development",
    "THAARA_VPS_PILOT_ACK": "isolated_synthetic_only",
    "THAARA_WHATSAPP_SEND_ENABLED": "false"
   },
   "healthcheck": {
    "test": [
     "CMD",
     "node",
     "-e",
     "fetch('http://127.0.0.1:3002/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
    ],
    "timeout": "5s",
    "interval": "15s",
    "retries": 5
   },
   "image": "sha256:7fbcfa2aa3c5c1f7e5a849e23092a746d0bc5bcb7bdf8b0177d7c6d2ad162018",
   "logging": {
    "driver": "json-file",
    "options": {
     "max-file": "3",
     "max-size": "10m"
    }
   },
   "mem_limit": "536870912",
   "networks": {
    "data": null,
    "entry": null
   },
   "pids_limit": 128,
   "ports": [
    {
     "mode": "ingress",
     "host_ip": "127.0.0.1",
     "target": 3002,
     "published": "15440",
     "protocol": "tcp"
    }
   ],
   "pull_policy": "never",
   "read_only": true,
   "secrets": [
    {
     "source": "api_password",
     "target": "/run/secrets/api_password"
    },
    {
     "source": "session_secret",
     "target": "/run/secrets/session_secret"
    },
    {
     "source": "csrf_secret",
     "target": "/run/secrets/csrf_secret"
    }
   ],
   "security_opt": [
    "no-new-privileges:true"
   ],
   "tmpfs": [
    "/tmp:rw,noexec,nosuid,size=33554432,uid=1000,gid=1000"
   ],
   "user": "1000:1000"
  },
  "postgres": {
   "cpus": 0.5,
   "command": null,
   "entrypoint": null,
   "environment": {
    "POSTGRES_DB": "thaara_vps_pilot",
    "POSTGRES_PASSWORD_FILE": "/run/secrets/admin_password",
    "POSTGRES_USER": "postgres"
   },
   "healthcheck": {
    "test": [
     "CMD",
     "pg_isready",
     "-U",
     "postgres",
     "-d",
     "thaara_vps_pilot"
    ],
    "timeout": "3s",
    "interval": "10s",
    "retries": 10
   },
   "image": "postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea",
   "logging": {
    "driver": "json-file",
    "options": {
     "max-file": "3",
     "max-size": "10m"
    }
   },
   "mem_limit": "402653184",
   "networks": {
    "data": null
   },
   "pids_limit": 128,
   "read_only": true,
   "secrets": [
    {
     "source": "admin_password",
     "target": "/run/secrets/admin_password"
    },
    {
     "source": "api_password",
     "target": "/run/secrets/api_password"
    }
   ],
   "security_opt": [
    "no-new-privileges:true"
   ],
   "shm_size": "67108864",
   "tmpfs": [
    "/tmp:rw,noexec,nosuid,size=33554432",
    "/var/run/postgresql:rw,noexec,nosuid,size=16777216,uid=999,gid=999"
   ],
   "user": "999:999",
   "volumes": [
    {
     "type": "volume",
     "source": "pgdata",
     "target": "/var/lib/postgresql/data"
    }
   ]
  },
  "redis": {
   "cap_drop": [
    "ALL"
   ],
   "cpus": 0.25,
   "command": [
    "/bin/sh",
    "-ec",
    "umask 077; p=$$(cat /run/secrets/redis_password); case $$p in ''|*[!A-Za-z0-9_-]*) exit 1;; esac; [ $${#p} -ge 32 ] && [ $${#p} -le 256 ]; printf 'bind 0.0.0.0\nprotected-mode yes\nport 6379\nappendonly yes\ndir /data\nmaxmemory 128mb\nmaxmemory-policy noeviction\nrequirepass %s\n' \"$$p\" > /run/redis/redis.conf; unset p; exec redis-server /run/redis/redis.conf"
   ],
   "entrypoint": null,
   "healthcheck": {
    "test": [
     "CMD-SHELL",
     "REDISCLI_AUTH=\"$$(cat /run/secrets/redis_password)\" redis-cli --no-auth-warning ping | grep -qx PONG"
    ],
    "timeout": "3s",
    "interval": "10s",
    "retries": 10
   },
   "image": "redis@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499",
   "logging": {
    "driver": "json-file",
    "options": {
     "max-file": "3",
     "max-size": "10m"
    }
   },
   "mem_limit": "201326592",
   "networks": {
    "data": null
   },
   "pids_limit": 64,
   "read_only": true,
   "secrets": [
    {
     "source": "redis_password",
     "target": "/run/secrets/redis_password"
    }
   ],
   "security_opt": [
    "no-new-privileges:true"
   ],
   "tmpfs": [
    "/run/redis:rw,noexec,nosuid,size=16777216,uid=999,gid=999"
   ],
   "user": "999:999",
   "volumes": [
    {
     "type": "volume",
     "source": "redisdata",
     "target": "/data"
    }
   ]
  }
 },
 "volumes": {
  "pgdata": {
   "name": "thaara-v2-pilot-pgdata"
  },
  "redisdata": {
   "name": "thaara-v2-pilot-redisdata"
  }
 }
}
