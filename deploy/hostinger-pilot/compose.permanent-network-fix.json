{
  "name": "thaara-v2-pilot",
  "services": {
    "postgres": {
      "image": "postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea",
      "user": "999:999",
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "environment": {
        "POSTGRES_DB": "thaara_vps_pilot",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/admin_password"
      },
      "secrets": [
        "admin_password",
        "api_password"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data"
        }
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=33554432",
        "/var/run/postgresql:rw,noexec,nosuid,size=16777216,uid=999,gid=999"
      ],
      "networks": [
        "data"
      ],
      "mem_limit": "384m",
      "cpus": 0.5,
      "pids_limit": 128,
      "shm_size": "64m",
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "thaara_vps_pilot"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "redis": {
      "image": "redis@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499",
      "user": "999:999",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "secrets": [
        "redis_password"
      ],
      "command": [
        "/bin/sh",
        "-ec",
        "umask 077; p=$$(cat /run/secrets/redis_password); case $$p in ''|*[!A-Za-z0-9_-]*) exit 1;; esac; [ $${#p} -ge 32 ] && [ $${#p} -le 256 ]; printf 'bind 0.0.0.0\\nprotected-mode yes\\nport 6379\\nappendonly yes\\ndir /data\\nmaxmemory 128mb\\nmaxmemory-policy noeviction\\nrequirepass %s\\n' \"$$p\" > /run/redis/redis.conf; unset p; exec redis-server /run/redis/redis.conf"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "redisdata",
          "target": "/data"
        }
      ],
      "tmpfs": [
        "/run/redis:rw,noexec,nosuid,size=16777216,uid=999,gid=999"
      ],
      "networks": [
        "data"
      ],
      "mem_limit": "192m",
      "cpus": 0.25,
      "pids_limit": 64,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$$(cat /run/secrets/redis_password)\" redis-cli --no-auth-warning ping | grep -qx PONG"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "api": {
      "image": "thaara-v2-pilot-api:google-drive-candidate",
      "pull_policy": "never",
      "profiles": [
        "application"
      ],
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "environment": {
        "NODE_ENV": "development",
        "THAARA_VPS_PILOT_ACK": "isolated_synthetic_only",
        "THAARA_WHATSAPP_SEND_ENABLED": "true",
        "THAARA_PHONE_DURABLE": "approved",
        "THAARA_PHONE_LIVE_CALLING": "approved",
        "THAARA_SARVAM_PROFILE_FILE": "/run/secrets/sarvam_profile",
        "THAARA_SARVAM_API_KEY_FILE": "/run/secrets/sarvam_api_key",
        "THAARA_SARVAM_WEBHOOK_SECRET_FILE": "/run/secrets/sarvam_webhook_secret",
        "THAARA_PHONE_CALLBACK_ORIGIN": "https://thaara-v2.quantumweaveai.io",
        "THAARA_OPENAI_API_KEY_FILE": "/run/secrets/openai_api_key",
        "THAARA_GOOGLE_OAUTH": "approved"
      },
      "secrets": [
        "api_password",
        "session_secret",
        "csrf_secret",
        "meta_access_token",
        "n8n_dispatch_secret",
        "send_profile",
        "sarvam_api_key",
        "sarvam_webhook_secret",
        "sarvam_profile",
        "openai_api_key",
        "google_client_id",
        "google_client_secret",
        "google_vault_key"
      ],
      "ports": [
        {
          "target": 3002,
          "published": "15440",
          "host_ip": "127.0.0.1",
          "protocol": "tcp"
        }
      ],
      "networks": [
        "data",
        "entry",
        "n8n_default"
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "pids_limit": 128,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=33554432,uid=1000,gid=1000"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3002/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5
      },
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "n8n_default",
        "traefik.http.routers.thaara-v2-pilot-https.entrypoints": "web,websecure",
        "traefik.http.routers.thaara-v2-pilot-https.rule": "Host(`thaara-v2.quantumweaveai.io`)",
        "traefik.http.routers.thaara-v2-pilot-https.tls": "true",
        "traefik.http.routers.thaara-v2-pilot-https.tls.certresolver": "mytlschallenge",
        "traefik.http.routers.thaara-v2-pilot-https.service": "thaara-v2-pilot",
        "traefik.http.services.thaara-v2-pilot.loadbalancer.server.port": "3002"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "data": {
      "name": "thaara-v2-pilot-data",
      "internal": true
    },
    "entry": {
      "name": "thaara-v2-pilot-entry"
    },
    "n8n_default": {
      "name": "n8n_default",
      "external": true
    }
  },
  "volumes": {
    "pgdata": {
      "name": "thaara-v2-pilot-pgdata"
    },
    "redisdata": {
      "name": "thaara-v2-pilot-redisdata"
    }
  },
  "secrets": {
    "admin_password": {
      "file": "/opt/thaara-v2-pilot-private/secrets/admin_password"
    },
    "api_password": {
      "file": "/opt/thaara-v2-pilot-private/secrets/api_password"
    },
    "redis_password": {
      "file": "/opt/thaara-v2-pilot-private/secrets/redis_password"
    },
    "session_secret": {
      "file": "/opt/thaara-v2-pilot-private/secrets/session_secret"
    },
    "csrf_secret": {
      "file": "/opt/thaara-v2-pilot-private/secrets/csrf_secret"
    },
    "meta_access_token": {
      "file": "/opt/thaara-v2-pilot-private/secrets/meta_access_token"
    },
    "n8n_dispatch_secret": {
      "file": "/opt/thaara-v2-pilot-private/secrets/n8n_dispatch_secret"
    },
    "send_profile": {
      "file": "/opt/thaara-v2-pilot-private/secrets/send_profile"
    },
    "sarvam_api_key": {
      "file": "/opt/thaara-v2-pilot-private/secrets/sarvam_api_key"
    },
    "sarvam_webhook_secret": {
      "file": "/opt/thaara-v2-pilot-private/secrets/sarvam_webhook_secret"
    },
    "sarvam_profile": {
      "file": "/opt/thaara-v2-pilot-private/secrets/sarvam_profile"
    },
    "openai_api_key": {
      "file": "/opt/thaara-v2-pilot-private/secrets/openai_api_key"
    },
    "google_client_id": {
      "file": "/opt/thaara-v2-pilot-private/secrets/google_client_id"
    },
    "google_client_secret": {
      "file": "/opt/thaara-v2-pilot-private/secrets/google_client_secret"
    },
    "google_vault_key": {
      "file": "/opt/thaara-v2-pilot-private/secrets/google_vault_key"
    }
  }
}
