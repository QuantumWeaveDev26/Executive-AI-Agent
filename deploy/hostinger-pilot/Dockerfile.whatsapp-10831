# Step 108.31 unified Phone + WhatsApp pilot overlay on thaara-v2-pilot-api
# Base image: sha256:c1b0524b69783a8482bf531dabd2bc91dd17e7857e16bc451e8ac0480a835673
# Preserves all Step 110 Phone/Sarvam routes, services, contracts, DB repositories, and /integrations/phone UI.
ARG BASE_IMAGE=sha256:c1b0524b69783a8482bf531dabd2bc91dd17e7857e16bc451e8ac0480a835673
FROM ${BASE_IMAGE}
COPY --chown=1000:1000 contracts/ /app/packages/contracts/dist/
COPY --chown=1000:1000 db/ /app/packages/db/dist/repositories/
COPY --chown=1000:1000 api-services/ /app/apps/api/dist/services/
COPY --chown=1000:1000 api-routes/ /app/apps/api/dist/routes/
RUN rm -rf /app/apps/web/dist/assets
COPY --chown=1000:1000 web-dist/ /app/apps/web/dist/
RUN node --input-type=module -e "import fs from 'node:fs'; import { dirname, join } from 'node:path'; import { fileURLToPath } from 'node:url'; \
  const contractsDir = dirname(fs.realpathSync(fileURLToPath(import.meta.resolve('@thaara/contracts')))); \
  const dbReposDir = join(dirname(fs.realpathSync(fileURLToPath(import.meta.resolve('@thaara/db')))), 'repositories'); \
  for (const f of ['meta-whatsapp.js', 'meta-whatsapp.d.ts', 'whatsapp-n8n.js', 'whatsapp-n8n.d.ts']) { \
    const src = '/app/packages/contracts/dist/' + f, dst = join(contractsDir, f); \
    if (src !== dst) fs.copyFileSync(src, dst); \
  } \
  for (const f of ['whatsapp-postgres.js', 'whatsapp-postgres.d.ts', 'whatsapp-state.js', 'whatsapp-state.d.ts']) { \
    const src = '/app/packages/db/dist/repositories/' + f, dst = join(dbReposDir, f); \
    if (src !== dst) fs.copyFileSync(src, dst); \
  } \
  const c = await import('@thaara/contracts'); \
  if (!c.WhatsAppStoredFailureMetadataSchema || !c.WhatsAppStoredAutoReplyMetadataSchema) throw Error('Missing 108.31 WhatsApp contracts'); \
  if (!c.PHONE_AI_CALL_ACTION || !c.PHONE_CALL_RESULT_READ_ACTION || !c.PhoneCallingDraftSchema) throw Error('Missing Step 110 Phone contracts'); \
  const db = await import('@thaara/db'); \
  if (!db.PostgresWhatsAppStateStore.toString().includes('failure_metadata')) throw Error('Missing 108.31 Postgres failure_metadata'); \
  if (!db.PhoneCallRepository) throw Error('Missing Step 110 PhoneCallRepository'); \
  const enq = await import('./dist/services/whatsapp-enquiries.js'); \
  if (typeof enq.extractWhatsAppCustomerEnquiry !== 'function') throw Error('Missing whatsapp-enquiries'); \
  const dur = await import('./dist/services/whatsapp-durable.js'); \
  if (typeof dur.DurableWhatsAppService !== 'function') throw Error('Missing whatsapp-durable'); \
  const ps = await import('./dist/services/phone-pilot-startup.js'); \
  const off = await ps.createPhoneStartup({}); if (off.status !== 'off') throw Error('Phone startup default must be off'); \
  const pc = await import('./dist/services/phone-calling.js'); \
  if (typeof pc.PhoneCallingService !== 'function') throw Error('Missing PhoneCallingService'); \
  const app = await import('./dist/app.js'); \
  if (typeof app.buildApp !== 'function') throw Error('Missing buildApp'); \
  const inboxRoute = fs.readFileSync('/app/apps/api/dist/routes/whatsapp-inbox.js', 'utf8'); \
  if (!inboxRoute.includes('/appointments/confirm')) throw Error('Missing appointment routes'); \
  const assets = fs.readdirSync('/app/apps/web/dist/assets'); \
  const jsBundle = assets.find((n) => n.endsWith('.js')); \
  if (!jsBundle) throw Error('Missing web JS bundle'); \
  const webJs = fs.readFileSync('/app/apps/web/dist/assets/' + jsBundle, 'utf8'); \
  if (!webJs.includes('/integrations/phone') || !webJs.includes('phone-call-page') || !webJs.includes('wa-appointment-box') || (!webJs.includes('CONFIRM APPOINTMENT') && !webJs.includes('Confirm Appointment'))) throw Error('Unified web bundle missing Phone, WhatsApp, or Appointment UI'); \
  console.log('Step 108.31 unified Phone + WhatsApp overlay verified');"
