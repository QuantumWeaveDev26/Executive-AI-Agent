# WhatsApp Unified AI Engine & Direct Calendly Release
# Base image: sha256:371cf2c14c74c025f690d924414907527589ef35bd454b25d6f7e211d9a9da0e (Current live production image)
ARG BASE_IMAGE=sha256:371cf2c14c74c025f690d924414907527589ef35bd454b25d6f7e211d9a9da0e
FROM ${BASE_IMAGE}

COPY --chown=1000:1000 contracts/ /app/packages/contracts/dist/
COPY --chown=1000:1000 api-app/ /app/apps/api/dist/
COPY --chown=1000:1000 api-services/ /app/apps/api/dist/services/
COPY --chown=1000:1000 api-routes/ /app/apps/api/dist/routes/
RUN rm -rf /app/apps/web/dist/assets
COPY --chown=1000:1000 web-dist/ /app/apps/web/dist/

RUN node --input-type=module -e "import fs from 'node:fs'; import { dirname, join } from 'node:path'; import { fileURLToPath } from 'node:url'; \
  const contractsDir = dirname(fs.realpathSync(fileURLToPath(import.meta.resolve('@thaara/contracts')))); \
  for (const f of ['whatsapp-n8n.js', 'whatsapp-n8n.d.ts']) { \
    const src = '/app/packages/contracts/dist/' + f, dst = join(contractsDir, f); \
    if (src !== dst) fs.copyFileSync(src, dst); \
  } \
  const c = await import('@thaara/contracts'); \
  if (!c.WhatsAppConversationEnquirySchema) throw Error('Missing WhatsAppConversationEnquirySchema'); \
  if (!c.WhatsAppConversationEnquirySchema.properties.referredWebsite) throw Error('Schema missing referredWebsite'); \
  if (!c.WhatsAppConversationEnquirySchema.properties.businessType) throw Error('Schema missing businessType'); \
  if (!c.CalendlyBookingEvidenceSchema) throw Error('Missing CalendlyBookingEvidenceSchema'); \
  const aiSvc = await import('./dist/services/whatsapp-ai-service.js'); \
  if (typeof aiSvc.WhatsAppAIService !== 'function') throw Error('Missing WhatsAppAIService'); \
  if (typeof aiSvc.buildWhatsAppSystemPrompt !== 'function') throw Error('Missing buildWhatsAppSystemPrompt'); \
  if (typeof aiSvc.isStandaloneGreeting !== 'function') throw Error('Missing isStandaloneGreeting'); \
  if (typeof aiSvc.buildThaaraIntroduction !== 'function') throw Error('Missing buildThaaraIntroduction'); \
  if (!aiSvc.buildThaaraIntroduction('en').includes('Thaara')) throw Error('Invalid Thaara introduction'); \
  const enq = await import('./dist/services/whatsapp-enquiries.js'); \
  if (typeof enq.extractCustomerEmail !== 'function') throw Error('Missing extractCustomerEmail in whatsapp-enquiries'); \
  if (enq.QUANTUM_WEAVE_WHATSAPP_CONTACT_LINK !== 'https://wa.me/919972965677') throw Error('Invalid WhatsApp contact link'); \
  if (!enq.CONSULTATION_INVITATION_EN.includes('30-minute consultation')) throw Error('Missing CONSULTATION_INVITATION_EN'); \
  const n8nRoute = fs.readFileSync('/app/apps/api/dist/routes/whatsapp-n8n.js', 'utf8'); \
  if (!n8nRoute.includes('max: 300')) throw Error('Missing machine rate limiting in whatsapp-n8n'); \
  const durableSvc = fs.readFileSync('/app/apps/api/dist/services/whatsapp-durable.js', 'utf8'); \
  if (!durableSvc.includes('result.acceptedMessages > 0')) throw Error('Missing status event fast path in whatsapp-durable'); \
  if (!durableSvc.includes('isProviderAccepted')) throw Error('Missing provider acceptance check in whatsapp-durable'); \
  if (!durableSvc.includes('whatsAppAIService')) throw Error('Missing whatsAppAIService in whatsapp-durable'); \
  const inboxRoute = fs.readFileSync('/app/apps/api/dist/routes/whatsapp-inbox.js', 'utf8'); \
  if (!inboxRoute.includes('https://calendly.com/team-brandmint/30min')) throw Error('Missing Calendly URL in whatsapp-inbox'); \
  if (!inboxRoute.includes('AWAITING_CUSTOMER_BOOKING')) throw Error('Missing AWAITING_CUSTOMER_BOOKING in whatsapp-inbox'); \
  if (!inboxRoute.includes('/appointments/decline')) throw Error('Missing appointments/decline in whatsapp-inbox'); \
  const sarvam = await import('./dist/services/phone-sarvam-calls.js'); \
  if (typeof sarvam.createSarvamCallProvider !== 'function') throw Error('Missing Sarvam provider'); \
  const sarvamRuntime = await import('./dist/services/phone-sarvam-runtime.js'); \
  if (typeof sarvamRuntime.loadSarvamRuntime !== 'function') throw Error('Missing Sarvam runtime'); \
  if (!fs.existsSync('/app/apps/api/dist/services/phone-sarvam-knowledge-binding.js')) throw Error('Missing Sarvam knowledge binding'); \
  if (!fs.existsSync('/app/apps/api/dist/routes/bulk-campaign.js')) throw Error('Missing bulk campaign routes'); \
  if (!fs.existsSync('/app/apps/api/dist/services/bulk-campaign.js')) throw Error('Missing bulk campaign services'); \
  const app = await import('./dist/app.js'); \
  if (typeof app.buildApp !== 'function') throw Error('Missing buildApp'); \
  const assets = fs.readdirSync('/app/apps/web/dist/assets'); \
  const jsBundle = assets.find((n) => n.endsWith('.js')); \
  if (!jsBundle) throw Error('Missing web JS bundle'); \
  const webJs = fs.readFileSync('/app/apps/web/dist/assets/' + jsBundle, 'utf8'); \
  if (!webJs.includes('Stored WhatsApp conversations') && !webJs.includes('wa-composer')) throw Error('Missing WhatsApp inbox UI in web bundle'); \
  console.log('WhatsApp Unified AI Engine release verification passed');"
