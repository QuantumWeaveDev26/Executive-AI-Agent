# Stage only these compiled artifacts; never copy the full API build (paused Phone).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chown=1000:1000 contracts/whatsapp-n8n.js /app/packages/contracts/dist/
COPY --chown=1000:1000 api-services/whatsapp-inbox.js /app/apps/api/dist/services/
COPY --chown=1000:1000 web-dist/ /app/apps/web/dist/
RUN node --input-type=module -e "import {copyFileSync,realpathSync} from 'node:fs'; import {dirname,join} from 'node:path'; import {fileURLToPath} from 'node:url'; \
  const source='/app/packages/contracts/dist/whatsapp-n8n.js'; \
  const target=realpathSync(join(dirname(fileURLToPath(import.meta.resolve('@thaara/contracts'))),'whatsapp-n8n.js')); \
  if(!target.startsWith('/app/apps/api/node_modules/') && target!==source)throw Error('Unexpected contracts runtime path'); \
  if(target!==source)copyFileSync(source,target); \
  const {N8nWhatsAppInboxSchema}=await import('@thaara/contracts'); \
  if(!Object.hasOwn(N8nWhatsAppInboxSchema.properties.messages.items.properties,'deliveryEvents'))throw Error('Runtime response contract missing delivery history'); \
  await import('./dist/services/whatsapp-inbox.js'); console.log('Runtime delivery-history response contract and projection verified');"
