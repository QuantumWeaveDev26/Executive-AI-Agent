        "jsCode": "const inputData = $input.all();\nconst original = $('Normalize Drive Directive').first()?.json || {};\nconst op = original.operation || 'drive_search';\nconst firstJson = inputData[0]?.json || {};\n\nif (firstJson.error) {\n  const rawErr = firstJson.error;\n  const errMsg = typeof rawErr === 'string' ? rawErr : (rawErr.message || rawErr.description || JSON.stringify(rawErr));\n  let userFriendly = errMsg;\n  if (/reconnected|Access could not be refreshed|invalid_grant|unauthorized/i.test(errMsg)) {\n    userFriendly = 'The Google Drive OAuth credential (BNt9B8jgVmexVQ1O) has expired or was revoked. Please reconnect the Google Drive account in n8n credentials.';\n  }\n  return {\n    json: {\n      success: false,\n      operation: op,\n      message: userFriendly,\n      files: []\n    }\n  };\n}\n\nconst normalizeFile = (raw, extractedText) => {\n  if (!raw || !raw.id) return undefined;\n  const isFolder = raw.mimeType === 'application/vnd.google-apps.folder';\n  const fallbackLink = isFolder\n    ? ('https://drive.google.com/drive/folders/' + raw.id)\n    : ('https://drive.google.com/file/d/' + raw.id + '/view');\n  return {\n    id: String(raw.id),\n    name: String(raw.name || original.fileName || original.title || original.name || raw.id),\n    mimeType: String(raw.mimeType || 'application/octet-stream'),\n    webViewLink: raw.webViewLink || fallbackLink,\n    ...(raw.iconLink ? { iconLink: raw.iconLink } : {}),\n    ...(raw.size !== undefined ? { size: Number(raw.size) } : {}),\n    ...(raw.createdTime ? { createdTime: raw.createdTime } : {}),\n    ...(raw.modifiedTime ? { modifiedTime: raw.modifiedTime } : {}),\n    ...(Array.isArray(raw.parents) ? { parents: raw.parents } : {}),\n    ...(typeof raw.shared === 'boolean' ? { shared: raw.shared } : {}),\n    ...(extractedText ? { content: extractedText, summary: extractedText.slice(0, 4000) } : {})\n  };\n};\n\nif (op === 'drive_read') {\n  const prepared = $('Prepare Drive Content Export').first()?.json || {};\n  if (prepared.notFound || !prepared.fileMeta) {\n    return {\n      json: {\n        success: false,\n        operation: op,\n        files: [],\n        message: 'Requested file was not found in Google Drive.'\n      }\n    };\n  }\n  const rawExport = typeof firstJson.data === 'string' ? firstJson.data : (typeof firstJson.body === 'string' ? firstJson.body : '');\n  const exportedText = rawExport ? rawExport.slice(0, 60000) : '';\n  const file = normalizeFile(prepared.fileMeta, exportedText);\n  return {\n    json: {\n      success: true,\n      operation: op,\n      file,\n      files: file ? [file] : [],\n      webViewLink: file?.webViewLink,\n      message: exportedText\n        ? ('Read ' + file.name + ' (' + exportedText.length + ' chars).')\n        : ('Retrieved metadata for ' + file.name + '.')\n    }\n  };\n}\n\nif (op === 'drive_create_folder') {\n  const folder = normalizeFile(firstJson);\n  return {\n    json: {\n      success: Boolean(folder),\n      operation: op,\n      folder,\n      file: folder,\n      webViewLink: folder?.webViewLink,\n      message: folder ? ('Created folder \"' + folder.name + '\".') : 'Folder creation returned no metadata.'\n    }\n  };\n}\n\nif (op === 'drive_create_doc' || op === 'drive_upload' || op === 'drive_rename_move') {\n  const file = normalizeFile(firstJson);\n  return {\n    json: {\n      success: Boolean(file),\n      operation: op,\n      file,\n      webViewLink: file?.webViewLink,\n      message: file ? ('Completed ' + op + ' for \"' + file.name + '\".') : ('Operation ' + op + ' returned no file metadata.')\n    }\n  };\n}\n\nif (op === 'drive_share') {\n  return {\n    json: {\n      success: Boolean(firstJson.id || firstJson.role),\n      operation: op,\n      webViewLink: original.fileId ? ('https://drive.google.com/file/d/' + original.fileId + '/view') : undefined,\n      message: 'Shared file with ' + (original.email || 'recipient') + ' as ' + (original.role || 'reader') + '.'\n    }\n  };\n}\n\nif (op === 'drive_delete') {\n  return {\n    json: {\n      success: Boolean(firstJson.id || firstJson.trashed),\n      operation: op,\n      message: 'Moved \"' + (firstJson.name || original.fileName || original.fileId) + '\" to Google Drive trash.'\n    }\n  };\n}\n\nconst rawFiles = Array.isArray(firstJson.files)\n  ? firstJson.files\n  : inputData.map(i => i.json).filter(j => j && j.id && j.name);\nconst validFiles = rawFiles.map(f => normalizeFile(f)).filter(Boolean);\nvalidFiles.sort((a, b) => new Date(b.modifiedTime || 0).getTime() - new Date(a.modifiedTime || 0).getTime());\n\nreturn {\n  json: {\n    success: true,\n    operation: op,\n    files: validFiles,\n    ...(validFiles[0] ? { file: validFiles[0] } : {}),\n    message: validFiles.length > 0\n      ? ('Successfully executed ' + op + ': found ' + validFiles.length + ' items.')\n      : 'No matching files found in your Google Drive.'\n  }\n};"
