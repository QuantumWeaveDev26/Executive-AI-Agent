    {
      "parameters": {
        "jsCode": "const payload = $input.item.json.body || $input.item.json;\nconst operation = payload.operation || 'drive_search';\nconst queryTerm = String(payload.query || payload.nameFilter || payload.fileName || '').trim();\nconst clauses = ['trashed = false'];\n\nif (operation === 'drive_list') {\n  const folderId = String(payload.folderId || 'root').trim().replace(/'/g, \"\\\\'\");\n  clauses.push(\"'\" + folderId + \"' in parents\");\n} else {\n  if (queryTerm) {\n    const safeTerm = queryTerm.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\n    clauses.push(\"name contains '\" + safeTerm + \"'\");\n  }\n  if (payload.folderId) {\n    const safeFolder = String(payload.folderId).trim().replace(/'/g, \"\\\\'\");\n    clauses.push(\"'\" + safeFolder + \"' in parents\");\n  }\n  if (payload.mimeTypeFilter) {\n    const safeMime = String(payload.mimeTypeFilter).trim().replace(/'/g, \"\\\\'\");\n    clauses.push(\"mimeType = '\" + safeMime + \"'\");\n  }\n}\n\nconst boundary = 'thaara_drive_multipart_boundary';\nlet multipartBody = '';\nif (operation === 'drive_create_doc' || operation === 'drive_upload') {\n  const isDoc = operation === 'drive_create_doc';\n  const meta = {\n    name: isDoc ? (payload.title || 'Untitled Document') : (payload.name || 'Untitled.txt'),\n    mimeType: isDoc ? 'application/vnd.google-apps.document' : (payload.mimeType || 'text/plain')\n  };\n  const parentId = payload.parentFolderId || (payload.folderId && payload.folderId !== 'root' ? payload.folderId : '');\n  if (parentId) meta.parents = [parentId];\n  const contentMime = isDoc ? 'text/plain' : (payload.mimeType || 'text/plain');\n  const rawContent = String(payload.content || '');\n  multipartBody =\n    '--' + boundary + '\\r\\n' +\n    'Content-Type: application/json; charset=UTF-8\\r\\n\\r\\n' +\n    JSON.stringify(meta) + '\\r\\n' +\n    '--' + boundary + '\\r\\n' +\n    'Content-Type: ' + contentMime + '; charset=UTF-8\\r\\n\\r\\n' +\n    rawContent + '\\r\\n' +\n    '--' + boundary + '--';\n}\n\nconst folderMeta = {\n  name: payload.name || 'New Folder',\n  mimeType: 'application/vnd.google-apps.folder',\n  ...(payload.parentFolderId ? { parents: [payload.parentFolderId] } : {})\n};\n\nreturn {\n  json: {\n    ...payload,\n    operation,\n    gdriveQuery: clauses.join(' and '),\n    pageSize: Math.min(Math.max(Number(payload.limit) || 15, 1), 50),\n    multipartBoundary: boundary,\n    multipartBody,\n    folderMetaJson: JSON.stringify(folderMeta),\n    renamePatchJson: JSON.stringify(payload.newName ? { name: payload.newName } : {}),\n    shareBodyJson: JSON.stringify({\n      type: 'user',\n      role: payload.role || 'reader',\n      emailAddress: payload.email || ''\n    })\n  }\n};"
      },
