    {
      "parameters": {
        "jsCode": "const metaResp = $input.first()?.json || {};\nconst directive = $('Normalize Drive Directive').first()?.json || {};\nif (metaResp.error) {\n  return { json: { error: metaResp.error, canExportText: false } };\n}\nconst candidate = metaResp.id ? metaResp : (Array.isArray(metaResp.files) ? metaResp.files[0] : null);\nif (!candidate || !candidate.id) {\n  return { json: { files: [], canExportText: false, notFound: true } };\n}\nconst mime = String(candidate.mimeType || '');\nlet exportUrl = '';\nif (mime === 'application/vnd.google-apps.document' || mime === 'application/vnd.google-apps.presentation') {\n  exportUrl = 'https://www.googleapis.com/drive/v3/files/' + encodeURIComponent(candidate.id) + '/export?mimeType=text%2Fplain';\n} else if (mime === 'application/vnd.google-apps.spreadsheet') {\n  exportUrl = 'https://www.googleapis.com/drive/v3/files/' + encodeURIComponent(candidate.id) + '/export?mimeType=text%2Fcsv';\n} else if (mime.startsWith('text/') || mime === 'application/json') {\n  exportUrl = 'https://www.googleapis.com/drive/v3/files/' + encodeURIComponent(candidate.id) + '?alt=media';\n}\nreturn {\n  json: {\n    fileMeta: candidate,\n    canExportText: Boolean(exportUrl),\n    exportUrl,\n    operation: directive.operation || 'drive_read'\n  }\n};"
      },
