      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst to = body.recipientEmail || 'client@brandmint.ai';\nconst name = body.recipientName || 'Client';\nconst subject = body.subject || 'Executive Briefing & Strategic Update';\nconst messageBody = body.body || '';\nconst autoSend = Boolean(body.autoSend);\nconst operation = body.operation || (autoSend ? 'send' : 'draft');\n\nreturn {\n  json: {\n    operation,\n    recipientEmail: to,\n    recipientName: name,\n    subject,\n    body: messageBody,\n    autoSend\n  }\n};"
      },
